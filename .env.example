# ==============================================================================
# Recipe Platform Environment Variables & Production Secrets Configuration
#
# IMPORTANT:
# - NEVER commit real secrets or production credentials to source control.
# - In local development, configure in `.dev.vars` or `.env`.
# - In Cloudflare production, set secrets using: `wrangler secret put <NAME>`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Credentials (Server-side Only)
# ------------------------------------------------------------------------------
# DeepSeek API Key for recipe analysis, editorial content, and SEO generation
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Runware API Key for hero image generation via FLUX.1 Schnell
RUNWARE_API_KEY=your_runware_api_key_here

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Security
# ------------------------------------------------------------------------------
# Username for admin panel access (/admin/*)
ADMIN_USERNAME=admin

# Bcrypt hash of admin password (generate via bcrypt with cost factor >= 10)
ADMIN_PASSWORD_HASH=$2a$10$exampleBcryptHashPlaceHolderOnlyReplaceMe

# Strong random secret for signing JWT session tokens (at least 32 characters)
JWT_SECRET=your_long_random_cryptographic_jwt_secret_here

# ------------------------------------------------------------------------------
# 3. Storage & Domain Configuration
# ------------------------------------------------------------------------------
# Public custom domain or CDN URL pointing to Cloudflare R2 bucket
# Example: https://media.example.com
R2_PUBLIC_URL=https://media.yoursite.com

# Canonical base URL of the publication (no trailing slash)
# Example: https://example.com
SITE_URL=https://bananabreadrecipe.xyz

# ------------------------------------------------------------------------------
# 4. Cloudflare Infrastructure (Configured via wrangler.toml)
# ------------------------------------------------------------------------------
# D1 Database Binding: DB
# R2 Bucket Binding: RECIPE_IMAGES
