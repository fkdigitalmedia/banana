---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const env = (Astro.locals as any).runtime?.env || {};
const configuredEmail = env.CONTACT_EMAIL || 'editorial@bananabread.org';
const siteUrl = env.SITE_URL || 'https://bananabread.org';

const title = "Contact Editorial — BananaBread";
const description = "Get in touch with the BananaBread editorial team for recipe corrections, culinary questions, feedback, or general inquiries.";
---

<BaseLayout title={title} description={description}>
  <div class="container page-container">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Contact' }
    ]} />

    <div class="contact-content prose">
      <h1>Contact the Editorial Team</h1>
      
      <p class="lead">We welcome inquiries from our readers, home bakers, and fellow food enthusiasts. Here is how you can connect with our team.</p>

      <div class="contact-card-grid">
        <div class="contact-card">
          <div class="card-icon">✉️</div>
          <h2>Direct Editorial Email</h2>
          <p>For questions regarding recipe methods, measurement feedback, or editorial corrections:</p>
          <a href={`mailto:${configuredEmail}`} class="contact-email-link">{configuredEmail}</a>
          <p class="response-time"><strong>Expected Response Time:</strong> Within 24 to 48 business hours.</p>
        </div>

        <div class="contact-card">
          <div class="card-icon">📋</div>
          <h2>Editorial Guidelines & Corrections</h2>
          <p>If you notice a typo, an inconsistent cooking temperature, or have a specific ingredient substitution question, please mention:</p>
          <ul class="inquiry-list">
            <li>The full recipe title and URL</li>
            <li>The specific ingredient or instruction step</li>
            <li>Your oven type or altitude if troubleshooting bake time</li>
          </ul>
        </div>
      </div>

      <div class="contact-reasons-section">
        <h2>What You Can Contact Us For</h2>
        <div class="reasons-grid">
          <div class="reason-item">
            <h3>Recipe Inquiries</h3>
            <p>Clarifications on baking times, pan conversions, or ingredient substitutions.</p>
          </div>
          <div class="reason-item">
            <h3>Corrections & Feedback</h3>
            <p>Reporting measurement ambiguities, broken links, or visual display issues.</p>
          </div>
          <div class="reason-item">
            <h3>Privacy & Data Rights</h3>
            <p>Inquiries regarding our privacy policy or requests related to personal data.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding: 2rem 1rem;
    max-width: 850px;
    margin: 0 auto;
  }
  
  .prose h1 {
    font-size: 2.5rem;
    color: var(--primary);
    margin-bottom: 1rem;
    text-align: center;
  }
  
  .lead {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .contact-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .contact-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .contact-card h2 {
    font-size: 1.35rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .contact-card p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .contact-email-link {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: underline;
    margin-bottom: 1rem;
    word-break: break-all;
  }

  .response-time {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: auto;
    border-top: 1px dashed var(--border);
    padding-top: 0.75rem;
  }

  .inquiry-list {
    font-size: 0.95rem;
    line-height: 1.6;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .inquiry-list li {
    margin-bottom: 0.5rem;
  }

  .contact-reasons-section {
    background-color: #FFFDF9;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
  }

  .contact-reasons-section h2 {
    font-size: 1.5rem;
    color: var(--primary);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .reason-item h3 {
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .reason-item p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }
</style>
