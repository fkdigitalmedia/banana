---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getEditorialQueue, getEditorialWorkflowStats } from '../../../lib/editorial/workflow';

const env = Astro.locals.runtime?.env;
const db = env?.DB;

if (!db) {
  return new Response('Database connection unavailable', { status: 500 });
}

// Search & Filter parameters
const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const status = url.searchParams.get('status') || 'all';
const quality = url.searchParams.get('quality') || 'all';
const image = url.searchParams.get('image') || 'all';

// Fetch queue items and stats
const stats = await getEditorialWorkflowStats(db);
const queue = await getEditorialQueue(db, { search, status, quality, image, limit: 50 });
---

<AdminLayout title="Editorial Review Queue" activePage="review">
  <div class="review-queue-page">
    <div class="header-section">
      <div>
        <h2>Editorial Review Queue</h2>
        <p class="subtitle">Review, fact-check, and approve recipe drafts before publishing</p>
      </div>
      <a href="/admin/import/" class="btn-import">+ Import Recipe</a>
    </div>

    <!-- Workflow Stats Bar -->
    <div class="stats-grid">
      <a href="/admin/review/?status=review_required" class={`stat-card ${status === 'review_required' ? 'active-filter' : ''}`}>
        <div class="stat-number color-review">{stats.needsReview}</div>
        <div class="stat-label">Needs Review</div>
        <div class="stat-hint">Pending editorial approval</div>
      </a>
      <a href="/admin/review/?status=approved" class={`stat-card ${status === 'approved' ? 'active-filter' : ''}`}>
        <div class="stat-number color-approved">{stats.approved}</div>
        <div class="stat-label">Approved</div>
        <div class="stat-hint">Ready to publish</div>
      </a>
      <a href="/admin/recipes/?status=published" class="stat-card">
        <div class="stat-number color-published">{stats.published}</div>
        <div class="stat-label">Published</div>
        <div class="stat-hint">Live on website</div>
      </a>
      <a href="/admin/review/?status=draft" class={`stat-card ${status === 'draft' ? 'active-filter' : ''}`}>
        <div class="stat-number color-draft">{stats.drafts}</div>
        <div class="stat-label">Drafts</div>
        <div class="stat-hint">Unfinished or work-in-progress</div>
      </a>
      <a href="/admin/review/?status=failed" class={`stat-card ${status === 'failed' ? 'active-filter' : ''}`}>
        <div class="stat-number color-failed">{stats.failed}</div>
        <div class="stat-label">Failed / Blocked</div>
        <div class="stat-hint">Requires manual attention</div>
      </a>
    </div>

    <!-- Filters & Search Form -->
    <div class="filters-card">
      <form method="GET" class="filter-form">
        <div class="filter-group flex-grow">
          <input 
            type="text" 
            name="q" 
            value={search} 
            placeholder="Search recipes by title or slug..." 
            class="input-search"
          />
        </div>
        <div class="filter-group">
          <select name="status" class="select-filter" onchange="this.form.submit()">
            <option value="all" selected={status === 'all'}>All Statuses</option>
            <option value="review_required" selected={status === 'review_required'}>Review Required (Priority)</option>
            <option value="approved" selected={status === 'approved'}>Approved</option>
            <option value="draft" selected={status === 'draft'}>Draft</option>
            <option value="published" selected={status === 'published'}>Published</option>
            <option value="unpublished" selected={status === 'unpublished'}>Unpublished</option>
            <option value="failed" selected={status === 'failed'}>Failed</option>
          </select>
        </div>
        <div class="filter-group">
          <select name="quality" class="select-filter" onchange="this.form.submit()">
            <option value="all" selected={quality === 'all'}>All Quality Scores</option>
            <option value="pass" selected={quality === 'pass'}>Pass (80 - 100)</option>
            <option value="review" selected={quality === 'review'}>Needs Attention (50 - 79)</option>
            <option value="fail" selected={quality === 'fail'}>Failed (&lt; 50)</option>
          </select>
        </div>
        <div class="filter-group">
          <select name="image" class="select-filter" onchange="this.form.submit()">
            <option value="all" selected={image === 'all'}>All Image States</option>
            <option value="ready" selected={image === 'ready'}>Image Ready</option>
            <option value="pending" selected={image === 'pending'}>Image Pending</option>
            <option value="failed" selected={image === 'failed'}>Image Failed</option>
          </select>
        </div>
        <button type="submit" class="btn-filter">Filter</button>
        {(search || status !== 'all' || quality !== 'all' || image !== 'all') && (
          <a href="/admin/review/" class="btn-clear">Clear</a>
        )}
      </form>
    </div>

    <!-- Review Queue Table -->
    <div class="table-container">
      {queue.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">☕</div>
          <h3>Queue is clear!</h3>
          <p>No recipes currently match your filter criteria.</p>
          <a href="/admin/import/" class="btn-action-import">Import New Recipe</a>
        </div>
      ) : (
        <table class="queue-table">
          <thead>
            <tr>
              <th>Recipe</th>
              <th>Pipeline</th>
              <th>Quality</th>
              <th>Image</th>
              <th>SEO</th>
              <th>Updated</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {queue.map((item: any) => {
              const score = item.quality_score || 0;
              const isStale = Boolean(item.content_stale);
              return (
                <tr class={`status-row-${item.status?.toLowerCase()}`}>
                  <td class="recipe-title-cell">
                    <div class="recipe-title-row">
                      <a href={`/admin/recipes/${item.id}/review/`} class="recipe-title-link">
                        {item.title || 'Untitled Recipe'}
                      </a>
                      {isStale && <span class="badge-stale" title="Locked facts were modified. Content is stale.">STALE</span>}
                    </div>
                    <div class="recipe-meta-sub">
                      <span class="recipe-slug">/{item.slug}/</span>
                      {item.category_name && <span class="badge-cat">{item.category_name}</span>}
                      <span class={`badge-status status-${item.status?.toLowerCase()}`}>{item.status}</span>
                    </div>
                  </td>
                  <td>
                    <span class={`pill-pipeline ${item.job_status === 'COMPLETED' ? 'pipe-ok' : item.job_status === 'FAILED' ? 'pipe-err' : 'pipe-run'}`}>
                      {item.job_stage || item.job_status || 'READY'}
                    </span>
                  </td>
                  <td>
                    <div class="quality-badge-wrap">
                      <span class={`score-pill ${score >= 80 ? 'score-pass' : score >= 50 ? 'score-warn' : 'score-fail'}`}>
                        {score}/100
                      </span>
                      <span class="score-subtext">
                        {score >= 80 ? 'PASS' : score >= 50 ? 'REVIEW' : 'FAIL'}
                      </span>
                    </div>
                  </td>
                  <td>
                    <span class={`pill-image ${item.image_status === 'READY' ? 'img-ready' : item.image_status === 'PENDING' ? 'img-pending' : 'img-none'}`}>
                      {item.image_status || 'PENDING'}
                    </span>
                  </td>
                  <td>
                    <span class="pill-seo seo-valid">✓ Ready</span>
                  </td>
                  <td class="updated-cell">
                    {new Date(item.updated_at || item.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                  </td>
                  <td class="actions-cell">
                    <div class="action-btn-group">
                      <a href={`/admin/recipes/${item.id}/review/`} class="btn-review">
                        Review →
                      </a>
                      <a href={`/admin/recipes/${item.id}/preview/`} target="_blank" class="btn-preview-link" title="Open Preview">
                        👁
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
  </div>

  <style>
    .review-queue-page {
      max-width: 1200px;
      margin: 0 auto;
    }
    .header-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    h2 {
      margin: 0 0 0.25rem 0;
      font-size: 1.5rem;
      color: #18181b;
    }
    .subtitle {
      margin: 0;
      color: #71717a;
      font-size: 0.875rem;
    }
    .btn-import {
      background-color: #2563eb;
      color: #fff;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.875rem;
    }
    .btn-import:hover {
      background-color: #1d4ed8;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: #fff;
      border: 1px solid #e4e4e7;
      border-radius: 8px;
      padding: 1rem 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .stat-card.active-filter {
      border-color: #2563eb;
      background-color: #f8faff;
    }
    .stat-number {
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .color-review { color: #d97706; }
    .color-approved { color: #2563eb; }
    .color-published { color: #16a34a; }
    .color-draft { color: #71717a; }
    .color-failed { color: #dc2626; }
    .stat-label {
      font-size: 0.875rem;
      font-weight: 600;
      margin-top: 0.25rem;
    }
    .stat-hint {
      font-size: 0.75rem;
      color: #a1a1aa;
      margin-top: 0.25rem;
    }

    /* Filters Card */
    .filters-card {
      background: #fff;
      border: 1px solid #e4e4e7;
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1.5rem;
    }
    .filter-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }
    .flex-grow {
      flex: 1;
      min-width: 200px;
    }
    .input-search, .select-filter {
      width: 100%;
      padding: 0.5rem 0.75rem;
      border: 1px solid #d4d4d8;
      border-radius: 6px;
      font-size: 0.875rem;
      background: #fff;
      box-sizing: border-box;
    }
    .btn-filter {
      background-color: #18181b;
      color: #fff;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      font-weight: 500;
    }
    .btn-clear {
      color: #71717a;
      text-decoration: none;
      font-size: 0.875rem;
      padding: 0.5rem;
    }

    /* Queue Table */
    .table-container {
      background: #fff;
      border: 1px solid #e4e4e7;
      border-radius: 8px;
      overflow: hidden;
    }
    .queue-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.875rem;
    }
    .queue-table th {
      background-color: #fafafa;
      padding: 0.75rem 1rem;
      font-weight: 600;
      color: #52525b;
      border-bottom: 1px solid #e4e4e7;
    }
    .queue-table td {
      padding: 1rem;
      border-bottom: 1px solid #f4f4f5;
      vertical-align: middle;
    }
    .queue-table tr:hover {
      background-color: #fafafa;
    }
    .recipe-title-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }
    .recipe-title-link {
      font-weight: 600;
      color: #18181b;
      text-decoration: none;
      font-size: 0.95rem;
    }
    .recipe-title-link:hover {
      color: #2563eb;
    }
    .recipe-meta-sub {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: #71717a;
    }
    .recipe-slug {
      font-family: monospace;
      color: #a1a1aa;
    }
    .badge-cat {
      background: #f4f4f5;
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
    }
    .badge-stale {
      background: #fee2e2;
      color: #b91c1c;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
      letter-spacing: 0.05em;
    }

    /* Status Badges */
    .badge-status {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }
    .status-review_required { background: #fef3c7; color: #92400e; }
    .status-approved { background: #dbeafe; color: #1e40af; }
    .status-published { background: #dcfce7; color: #166534; }
    .status-draft { background: #f4f4f5; color: #52525b; }
    .status-unpublished { background: #e4e4e7; color: #71717a; }
    .status-failed { background: #fee2e2; color: #991b1b; }

    /* Quality pill */
    .quality-badge-wrap {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
    .score-pill {
      font-weight: 700;
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
    }
    .score-pass { background: #dcfce7; color: #166534; }
    .score-warn { background: #fef3c7; color: #92400e; }
    .score-fail { background: #fee2e2; color: #991b1b; }
    .score-subtext {
      font-size: 0.7rem;
      color: #71717a;
      font-weight: 600;
    }

    /* Pipeline & Image Pills */
    .pill-pipeline, .pill-image, .pill-seo {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-weight: 500;
    }
    .pipe-ok { background: #f0fdf4; color: #166534; }
    .pipe-run { background: #fef9c3; color: #854d0e; }
    .pipe-err { background: #fef2f2; color: #991b1b; }
    .img-ready { background: #eff6ff; color: #1e40af; }
    .img-pending { background: #fefce8; color: #a16207; }
    .img-none { background: #f4f4f5; color: #71717a; }
    .seo-valid { color: #16a34a; font-weight: 600; }

    .updated-cell {
      font-size: 0.8rem;
      color: #71717a;
      white-space: nowrap;
    }

    .action-btn-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-review {
      background-color: #18181b;
      color: #fff;
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .btn-review:hover {
      background-color: #2563eb;
    }
    .btn-preview-link {
      background: #f4f4f5;
      color: #52525b;
      padding: 0.375rem 0.5rem;
      border-radius: 6px;
      text-decoration: none;
      font-size: 0.875rem;
    }
    .btn-preview-link:hover {
      background: #e4e4e7;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
    }
    .empty-icon {
      font-size: 2.5rem;
      margin-bottom: 0.75rem;
    }
    .empty-state h3 {
      margin: 0 0 0.5rem 0;
    }
    .empty-state p {
      color: #71717a;
      margin: 0 0 1.5rem 0;
    }
    .btn-action-import {
      display: inline-block;
      background: #2563eb;
      color: #fff;
      padding: 0.5rem 1.25rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.875rem;
    }
  </style>
</AdminLayout>
