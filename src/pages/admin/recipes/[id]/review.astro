---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getRecipeWithAllDetails } from '../../../../lib/db/recipes';
import { reconstructFactSheet } from '../../../../lib/pipeline/runner';
import { evaluateRecipeQuality } from '../../../../lib/quality/engine';
import { getRecipeRevisions } from '../../../../lib/editorial/workflow';
import { generateRecipeJsonLd, generateBreadcrumbJsonLd } from '../../../../lib/seo/jsonld';

const { id } = Astro.params;
const recipeId = parseInt(id || '0', 10);

const env = Astro.locals.runtime?.env;
const db = env?.DB;
const siteUrl = env?.SITE_URL || 'https://yoursite.com';
const r2BaseUrl = env?.R2_PUBLIC_URL || '';

if (!recipeId || !db) {
  return Astro.redirect('/admin/review/');
}

const recipe = await getRecipeWithAllDetails(db, recipeId);
if (!recipe) {
  return Astro.redirect('/admin/review/');
}

const content = recipe.content || {};
const seo = recipe.seo || {};
const revisions = await getRecipeRevisions(db, recipeId, 15);

// Reconstruct FactSheet and run Quality Engine
const factSheet = reconstructFactSheet(recipe);
const parseIfJson = (v: any) => typeof v === 'string' && (v.startsWith('[') || v.startsWith('{')) ? JSON.parse(v) : v;

const evalContent = {
  introduction: content.introduction || '',
  whyThisRecipe: content.why_this_recipe || '',
  ingredientGuidance: parseIfJson(content.ingredient_guidance) || [],
  cookingGuidance: parseIfJson(content.cooking_guidance) || [],
  tips: parseIfJson(content.tips) || [],
  variations: parseIfJson(content.variations) || [],
  servingSuggestions: content.serving_suggestions || '',
  storage: content.storage || '',
  faq: parseIfJson(content.faq) || [],
  seo: {
    title: seo.seo_title || recipe.title,
    metaDescription: seo.meta_description || recipe.description || '',
    slug: recipe.slug
  }
};

const qualityReport = evaluateRecipeQuality(factSheet.lockedFacts, evalContent);
const isStale = Boolean(recipe.content_stale);
const score = qualityReport.score;
const canPublish = recipe.status === 'APPROVED';

// JSON-LD Schema preview
const jsonLdPreview = generateRecipeJsonLd(
  recipe,
  recipe.ingredients || [],
  recipe.instructions || [],
  content,
  seo,
  siteUrl,
  r2BaseUrl
);

const breadcrumbPreview = generateBreadcrumbJsonLd(recipe.title, recipe.slug, siteUrl, recipe.category_name, recipe.category_slug);
---

<AdminLayout title={`Review: ${recipe.title}`} activePage="review">
  <div class="review-page">
    <!-- Top Action & Status Bar -->
    <div class="top-nav-bar">
      <div class="nav-left">
        <a href="/admin/review/" class="back-link">← Back to Review Queue</a>
        <div class="title-with-status">
          <h1>{recipe.title}</h1>
          <span class={`status-pill status-${recipe.status?.toLowerCase()}`}>{recipe.status}</span>
          {isStale && (
            <span class="stale-alert-pill" title="Locked recipe facts were changed. Re-review recommended.">
              ⚠ CONTENT STALE
            </span>
          )}
        </div>
      </div>
      <div class="nav-actions">
        <a href={`/admin/recipes/${recipe.id}/preview/`} target="_blank" class="btn-secondary">
          👁 Public Preview
        </a>
        <button id="rerun-quality-btn" class="btn-secondary">
          ↺ Re-run Quality Check
        </button>
        {recipe.status !== 'APPROVED' && recipe.status !== 'PUBLISHED' && (
          <button id="approve-recipe-btn" class="btn-primary">
            ✓ Approve for Publishing
          </button>
        )}
        {recipe.status === 'APPROVED' && (
          <button id="publish-recipe-btn" class="btn-publish">
            🚀 Publish Live
          </button>
        )}
        {recipe.status === 'PUBLISHED' && (
          <button id="unpublish-recipe-btn" class="btn-danger">
            ⏸ Unpublish
          </button>
        )}
      </div>
    </div>

    <!-- Quality Gate & Score Card -->
    <div class="quality-gate-banner">
      <div class="score-card">
        <div class="score-main">
          <div class={`score-circle ${score >= 80 ? 'circle-pass' : score >= 50 ? 'circle-warn' : 'circle-fail'}`}>
            <span class="score-val">{score}</span>
            <span class="score-max">/100</span>
          </div>
          <div>
            <div class="score-title">Content Quality & Fact Consistency</div>
            <div class="score-desc">
              {score >= 80 ? 'Quality gate passed. Meets all editorial and factual standards.' : 'Quality issues detected. Must be resolved before publishing.'}
            </div>
          </div>
        </div>

        <div class="checks-grid">
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories.facts.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">FACT CONSISTENCY</span>
            <span class="check-badge">{qualityReport.categories.facts.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories.completeness.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">COMPLETENESS</span>
            <span class="check-badge">{qualityReport.categories.completeness.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories.repetition.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">REPETITION</span>
            <span class="check-badge">{qualityReport.categories.repetition.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories.seo.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">SEO QUALITY</span>
            <span class="check-badge">{qualityReport.categories.seo.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories?.schema?.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">STRUCTURED DATA</span>
            <span class="check-badge">{qualityReport.categories?.schema?.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
          <div class="check-item">
            <span class="check-icon">{qualityReport.categories?.safety?.score >= 80 ? '✓' : '✗'}</span>
            <span class="check-label">FACT SAFETY (v2)</span>
            <span class="check-badge">{qualityReport.categories?.safety?.score >= 80 ? 'PASS' : 'FAIL'}</span>
          </div>
        </div>
      </div>

      <!-- Issues List -->
      {qualityReport.issues.length > 0 && (
        <div class="issues-box">
          <div class="issues-header">
            <h4>Detected Issues & Warnings ({qualityReport.issues.length})</h4>
          </div>
          <div class="issues-list">
            {qualityReport.issues.map((issue) => (
              <div class={`issue-item severity-${issue.severity.toLowerCase()}`}>
                <div class="issue-badge">{issue.severity}</div>
                <div class="issue-content">
                  <div class="issue-msg">{issue.message}</div>
                  <div class="issue-details">
                    <span>Category: <strong>{issue.category}</strong></span>
                    {issue.section && <span>Section: <strong>{issue.section}</strong></span>}
                    {issue.autoFixable && <span class="badge-autofix">Auto-repairable</span>}
                  </div>
                </div>
                {issue.section && (
                  <button class="btn-fix-issue" onclick={`regenerateSpecificSection('${issue.section}')`}>
                    ↺ Regenerate {issue.section}
                  </button>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Main Editorial Layout: Left (Locked Facts) vs Right (Generated Content) -->
    <div class="editorial-comparison-grid">
      
      <!-- LEFT COLUMN: LOCKED RECIPE FACTS -->
      <div class="locked-facts-column">
        <div class="column-header locked-header">
          <div class="header-icon-title">
            <span class="lock-icon">🔒</span>
            <h3>LOCKED RECIPE FACTS</h3>
          </div>
        <!-- EXTRACTION PROVENANCE & QUALITY CARD -->
        <div class="provenance-card">
          <div class="provenance-grid">
            <div class="prov-item">
              <span class="prov-label">Method</span>
              <span class="prov-val">{recipe.extraction_method || 'JSON-LD'}</span>
            </div>
            <div class="prov-item">
              <span class="prov-label">Quality</span>
              <span class={`prov-badge badge-${(recipe.extraction_confidence || 'HIGH').toLowerCase()}`}>
                {recipe.extraction_confidence || 'HIGH'}
              </span>
            </div>
            <div class="prov-item">
              <span class="prov-label">Imported</span>
              <span class="prov-val">{recipe.created_at ? new Date(recipe.created_at).toLocaleDateString() : '—'}</span>
            </div>
          </div>
          {recipe.source_url && (
            <div class="prov-source">
              <span class="prov-label">Source URL:</span>
              <a href={recipe.source_url} target="_blank" rel="noopener noreferrer" class="source-url-link">
                {recipe.source_url}
              </a>
            </div>
          )}
          {recipe.extraction_confidence === 'LOW' && (
            <div class="extraction-warning">
              ⚠️ <strong>Review Required:</strong> Extraction confidence is LOW. Please carefully inspect locked facts below before publishing.
            </div>
          )}
        </div>

        <div class="facts-card">
          <div class="fact-row">
            <span class="fact-label">Recipe Title</span>
            <span class="fact-value" id="fact-title-val">{recipe.title}</span>
          </div>

          <div class="fact-meta-grid">
            <div class="meta-box">
              <span class="meta-box-label">Prep Time</span>
              <span class="meta-box-val">{recipe.prep_time || 0} min</span>
            </div>
            <div class="meta-box">
              <span class="meta-box-label">Cook Time</span>
              <span class="meta-box-val">{recipe.cook_time || 0} min</span>
            </div>
            <div class="meta-box">
              <span class="meta-box-label">Total Time</span>
              <span class="meta-box-val">{recipe.total_time || 0} min</span>
            </div>
            <div class="meta-box">
              <span class="meta-box-label">Servings / Yield</span>
              <span class="meta-box-val">{recipe.yield_text || recipe.servings || 'N/A'}</span>
            </div>
          </div>

          {factSheet.lockedFacts.temperature && (
            <div class="temperature-alert">
              <span class="temp-icon">🌡</span>
              <span>Baking Temperature: <strong>{factSheet.lockedFacts.temperature}</strong></span>
            </div>
          )}

          <div class="facts-section-title">Ingredients ({recipe.ingredients?.length || 0})</div>
          <ul class="locked-ingredients-list">
            {(recipe.ingredients || []).map((ing: any) => (
              <li>
                <span class="ing-qty">{ing.quantity} {ing.unit}</span>
                <span class="ing-name"><strong>{ing.name}</strong></span>
                {ing.notes && <span class="ing-notes">({ing.notes})</span>}
              </li>
            ))}
          </ul>

          <div class="facts-section-title">Instructions ({recipe.instructions?.length || 0} steps)</div>
          <ol class="locked-instructions-list">
            {(recipe.instructions || []).map((inst: any) => (
              <li>
                <div class="step-num">{inst.step_number}</div>
                <div class="step-text">{inst.instruction}</div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Facts Edit Drawer / Modal (Initially Hidden) -->
        <div id="facts-edit-drawer" class="facts-drawer hidden">
          <div class="drawer-header">
            <h4>Edit Locked Recipe Facts</h4>
            <button id="close-facts-drawer" class="btn-close-drawer">✕</button>
          </div>
          <div class="drawer-warning">
            ⚠ Warning: Editing locked facts will mark existing generated content as <strong>STALE</strong> and invalidate publishing approval.
          </div>
          <form id="edit-facts-form">
            <div class="form-group">
              <label>Title</label>
              <input type="text" name="title" value={recipe.title} class="form-input" required />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Prep (min)</label>
                <input type="number" name="prep_time" value={recipe.prep_time} class="form-input" />
              </div>
              <div class="form-group">
                <label>Cook (min)</label>
                <input type="number" name="cook_time" value={recipe.cook_time} class="form-input" />
              </div>
              <div class="form-group">
                <label>Servings</label>
                <input type="text" name="servings" value={recipe.servings} class="form-input" />
              </div>
            </div>
            <div class="form-group">
              <label>Ingredients (one per line, e.g. "2 cups all-purpose flour")</label>
              <textarea name="raw_ingredients" rows="8" class="form-textarea">{(recipe.ingredients || []).map((i: any) => `${i.quantity || ''} ${i.unit || ''} ${i.name} ${i.notes ? `(${i.notes})` : ''}`.trim()).join('\n')}</textarea>
            </div>
            <div class="form-group">
              <label>Instructions (one per line)</label>
              <textarea name="raw_instructions" rows="8" class="form-textarea">{(recipe.instructions || []).map((i: any) => i.instruction).join('\n')}</textarea>
            </div>
            <div class="drawer-actions">
              <button type="submit" class="btn-primary">Save Facts & Mark Stale</button>
              <button type="button" id="cancel-facts-btn" class="btn-secondary">Cancel</button>
            </div>
          </form>
        </div>
      </div>

      <!-- RIGHT COLUMN: GENERATED CONTENT REVIEW -->
      <div class="generated-content-column">
        <div class="column-header">
          <h3>GENERATED EDITORIAL CONTENT</h3>
          <span class="ai-badge">DeepSeek AI Generated</span>
        </div>

        <!-- Section: Introduction -->
        <div class="content-section-box" id="sec-introduction">
          <div class="section-box-header">
            <h4>1. Introduction & Positioning</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('introduction')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('introduction')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-introduction">
            <p class="intro-paragraph">{content.introduction || 'No introduction generated yet.'}</p>
            {content.why_this_recipe && (
              <div class="why-subbox">
                <strong>Why You'll Love This Recipe:</strong>
                <p>{content.why_this_recipe}</p>
              </div>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-introduction">
            <textarea class="edit-textarea" rows="4">{content.introduction || ''}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionContent('introduction')">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('introduction')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: Ingredient Guidance -->
        <div class="content-section-box" id="sec-ingredientGuidance">
          <div class="section-box-header">
            <h4>2. Ingredient Guidance</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('ingredientGuidance')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('ingredientGuidance')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-ingredientGuidance">
            {evalContent.ingredientGuidance.length === 0 ? (
              <p class="empty-note">No ingredient guidance generated.</p>
            ) : (
              <div class="guidance-items-list">
                {evalContent.ingredientGuidance.map((item: any) => (
                  <div class="guidance-item">
                    <strong>{item.ingredient}:</strong> {item.guidance}
                  </div>
                ))}
              </div>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-ingredientGuidance">
            <textarea class="edit-textarea" rows="6">{JSON.stringify(evalContent.ingredientGuidance, null, 2)}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionContent('ingredientGuidance', true)">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('ingredientGuidance')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: Cooking Guidance -->
        <div class="content-section-box" id="sec-cookingGuidance">
          <div class="section-box-header">
            <h4>3. Step-by-Step Cooking Notes</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('cookingGuidance')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('cookingGuidance')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-cookingGuidance">
            {evalContent.cookingGuidance.length === 0 ? (
              <p class="empty-note">No step guidance generated.</p>
            ) : (
              <ul class="cooking-notes-list">
                {evalContent.cookingGuidance.map((note: string) => (
                  <li>{note}</li>
                ))}
              </ul>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-cookingGuidance">
            <textarea class="edit-textarea" rows="6">{evalContent.cookingGuidance.join('\n')}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionLines('cookingGuidance')">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('cookingGuidance')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: Tips -->
        <div class="content-section-box" id="sec-tips">
          <div class="section-box-header">
            <h4>4. Baker's Pro Tips</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('tips')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('tips')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-tips">
            {evalContent.tips.length === 0 ? (
              <p class="empty-note">No tips generated.</p>
            ) : (
              <ul class="tips-review-list">
                {evalContent.tips.map((t: string) => (
                  <li>💡 {t}</li>
                ))}
              </ul>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-tips">
            <textarea class="edit-textarea" rows="6">{evalContent.tips.join('\n')}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionLines('tips')">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('tips')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: Variations -->
        <div class="content-section-box" id="sec-variations">
          <div class="section-box-header">
            <h4>5. Variations</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('variations')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('variations')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-variations">
            {evalContent.variations.length === 0 ? (
              <p class="empty-note">No variations generated.</p>
            ) : (
              <div class="variations-review-list">
                {evalContent.variations.map((v: any) => (
                  <div class="var-item">
                    <strong>{v.name}:</strong> {v.description}
                  </div>
                ))}
              </div>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-variations">
            <textarea class="edit-textarea" rows="6">{JSON.stringify(evalContent.variations, null, 2)}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionContent('variations', true)">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('variations')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: Storage & Serving -->
        <div class="content-section-box" id="sec-storage">
          <div class="section-box-header">
            <h4>6. Serving & Storage</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('storage')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('storage')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-storage">
            <div class="storage-row">
              <strong>Serving:</strong> {content.serving_suggestions || 'None specified.'}
            </div>
            <div class="storage-row">
              <strong>Storage & Freezing:</strong> {content.storage || 'None specified.'}
            </div>
          </div>
          <div class="section-edit-form hidden" id="edit-storage">
            <div class="form-group">
              <label>Serving Suggestions</label>
              <input type="text" id="edit-serving-input" value={content.serving_suggestions || ''} class="form-input" />
            </div>
            <div class="form-group">
              <label>Storage Guidance</label>
              <textarea id="edit-storage-input" rows="3" class="form-textarea">{content.storage || ''}</textarea>
            </div>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveStorageServing()">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('storage')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Section: FAQ -->
        <div class="content-section-box" id="sec-faq">
          <div class="section-box-header">
            <h4>7. Frequently Asked Questions ({evalContent.faq.length})</h4>
            <div class="section-actions">
              <button class="btn-regen" onclick="regenerateSpecificSection('faq')">↺ Regenerate</button>
              <button class="btn-edit" onclick="toggleEditSection('faq')">✏ Edit</button>
            </div>
          </div>
          <div class="section-box-body" id="view-faq">
            {evalContent.faq.length === 0 ? (
              <p class="empty-note">No FAQs generated.</p>
            ) : (
              <div class="faq-review-list">
                {evalContent.faq.map((item: any) => (
                  <details class="faq-item">
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            )}
          </div>
          <div class="section-edit-form hidden" id="edit-faq">
            <textarea class="edit-textarea" rows="8">{JSON.stringify(evalContent.faq, null, 2)}</textarea>
            <div class="edit-btn-row">
              <button class="btn-save-sm" onclick="saveSectionContent('faq', true)">Save Section</button>
              <button class="btn-cancel-sm" onclick="toggleEditSection('faq')">Cancel</button>
            </div>
          </div>
        </div>

        <!-- HERO IMAGE REVIEW CARD -->
        <div class="image-review-card">
          <div class="section-box-header">
            <h4>8. Hero Image Review</h4>
            <div class="section-actions">
              <button id="regen-image-btn" class="btn-regen">↺ Regenerate Image</button>
            </div>
          </div>
          <div class="image-review-body">
            <div class="image-preview-box">
              {recipe.hero_image_key ? (
                <img 
                  src={`/api/image/${recipe.hero_image_key}`} 
                  alt={recipe.title} 
                  class="hero-preview-img" 
                />
              ) : (
                <div class="no-img-box">No hero image generated yet</div>
              )}
            </div>
            <div class="image-meta-info">
              <div>Status: <span class={`pill-image img-${recipe.image_status?.toLowerCase()}`}>{recipe.image_status || 'PENDING'}</span></div>
              <div>Key: <code>{recipe.hero_image_key || 'none'}</code></div>
              <div>Model: <strong>{recipe.image_model || 'FLUX.1 Schnell'}</strong></div>
              <div>Provider: <strong>{recipe.image_provider || 'Runware'}</strong></div>
              {recipe.image_prompt && (
                <div class="image-prompt-box">
                  <strong>Prompt:</strong> {recipe.image_prompt}
                </div>
              )}
            </div>
          </div>
        </div>

