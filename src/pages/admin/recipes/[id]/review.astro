  <!-- Client-side Interactive Logic -->
  <script define:vars={{ recipeId }}>
    // Approve Recipe Button
    const approveBtn = document.getElementById('approve-recipe-btn');
    if (approveBtn) {
      approveBtn.addEventListener('click', async () => {
        approveBtn.disabled = true;
        approveBtn.textContent = 'Validating...';
        try {
          const res = await fetch('/api/editorial/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipeId })
          });
          const data = await res.json();
          if (data.success) {
            alert('✓ Recipe APPROVED for publishing!');
            window.location.reload();
          } else {
            alert('Approval Blocked: ' + (data.error || 'Validation failed.'));
            approveBtn.disabled = false;
            approveBtn.textContent = '✓ Approve for Publishing';
          }
        } catch (e) {
          alert('Network error while approving recipe.');
          approveBtn.disabled = false;
          approveBtn.textContent = '✓ Approve for Publishing';
        }
      });
    }

    // Publish Live Button
    const publishBtn = document.getElementById('publish-recipe-btn');
    if (publishBtn) {
      publishBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to PUBLISH this recipe live to the website?')) return;
        publishBtn.disabled = true;
        publishBtn.textContent = 'Publishing...';
        try {
          const res = await fetch('/api/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipeId })
          });
          const data = await res.json();
          if (data.success) {
            alert('🚀 Recipe published successfully!');
            window.location.reload();
          } else {
            alert('Publishing failed: ' + (data.error || 'Server error'));
            publishBtn.disabled = false;
            publishBtn.textContent = '🚀 Publish Live';
          }
        } catch (e) {
          alert('Network error while publishing.');
          publishBtn.disabled = false;
        }
      });
    }

    // Unpublish Button
    const unpubBtn = document.getElementById('unpublish-recipe-btn');
    if (unpubBtn) {
      unpubBtn.addEventListener('click', async () => {
        if (!confirm('Unpublish this recipe? The public page will return 404.')) return;
        try {
          const res = await fetch('/api/unpublish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipeId })
          });
          const data = await res.json();
          if (data.success) {
            alert('Recipe unpublished.');
            window.location.reload();
          } else {
            alert('Unpublish failed: ' + (data.error || 'Error'));
          }
        } catch (e) {
          alert('Network error while unpublishing.');
        }
      });
    }

    // Re-run Quality Check Button
    const rerunQualityBtn = document.getElementById('rerun-quality-btn');
    if (rerunQualityBtn) {
      rerunQualityBtn.addEventListener('click', async () => {
        rerunQualityBtn.disabled = true;
        rerunQualityBtn.textContent = 'Evaluating...';
        try {
          const res = await fetch('/api/quality/evaluate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipeId })
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert('Quality check error: ' + (data.error || 'Error'));
            rerunQualityBtn.disabled = false;
            rerunQualityBtn.textContent = '↺ Re-run Quality Check';
          }
        } catch (e) {
          window.location.reload();
        }
      });
    }

    // Facts Drawer toggle
    const toggleFactsBtn = document.getElementById('toggle-edit-facts-btn');
    const factsDrawer = document.getElementById('facts-edit-drawer');
    const closeFactsBtn = document.getElementById('close-facts-drawer');
    const cancelFactsBtn = document.getElementById('cancel-facts-btn');

    if (toggleFactsBtn && factsDrawer) {
      toggleFactsBtn.addEventListener('click', () => factsDrawer.classList.toggle('hidden'));
    }
    if (closeFactsBtn && factsDrawer) {
      closeFactsBtn.addEventListener('click', () => factsDrawer.classList.add('hidden'));
    }
    if (cancelFactsBtn && factsDrawer) {
      cancelFactsBtn.addEventListener('click', () => factsDrawer.classList.add('hidden'));
    }

    // Save Facts Form
    const editFactsForm = document.getElementById('edit-facts-form');
    if (editFactsForm) {
      editFactsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(editFactsForm);
        const title = formData.get('title');
        const prep_time = formData.get('prep_time');
        const cook_time = formData.get('cook_time');
        const servings = formData.get('servings');
        const rawIngs = (formData.get('raw_ingredients') || '').toString().split('\n').map(l => l.trim()).filter(Boolean);
        const rawInsts = (formData.get('raw_instructions') || '').toString().split('\n').map(l => l.trim()).filter(Boolean);

        const ingredients = rawIngs.map((line, idx) => ({ name: line, originalText: line, sortOrder: idx }));
        const instructions = rawInsts.map((line, idx) => ({ stepNumber: idx + 1, instruction: line }));

        try {
          const res = await fetch('/api/editorial/update-facts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              recipeId,
              title,
              prep_time,
              cook_time,
              servings,
              ingredients,
              instructions
            })
          });
          const data = await res.json();
          if (data.success) {
            alert('✓ Facts updated. Generated content marked STALE. Approval reset to REVIEW_REQUIRED.');
            window.location.reload();
          } else {
            alert('Failed to update facts: ' + (data.error || 'Error'));
          }
        } catch (err) {
          alert('Network error updating facts.');
        }
      });
    }

    // SEO Drawer Toggle
    const editSeoBtn = document.getElementById('edit-seo-btn');
    const seoDrawer = document.getElementById('seo-edit-drawer');
    const cancelSeoBtn = document.getElementById('cancel-seo-btn');
    if (editSeoBtn && seoDrawer) {
      editSeoBtn.addEventListener('click', () => seoDrawer.classList.toggle('hidden'));
    }
    if (cancelSeoBtn && seoDrawer) {
      cancelSeoBtn.addEventListener('click', () => seoDrawer.classList.add('hidden'));
    }

    // Save SEO Form
    const editSeoForm = document.getElementById('edit-seo-form');
    if (editSeoForm) {
      editSeoForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(editSeoForm);
        try {
          const res = await fetch('/api/editorial/update-seo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              recipeId,
              seo_title: formData.get('seo_title'),
              meta_description: formData.get('meta_description'),
              slug: formData.get('slug')
            })
          });
          const data = await res.json();
          if (data.success) {
            alert('SEO metadata updated.');
            window.location.reload();
          } else {
            alert('Error updating SEO: ' + data.error);
          }
        } catch (e) {
          alert('Network error updating SEO.');
        }
      });
    }

    // Hero Image Regenerate Button
    const regenImgBtn = document.getElementById('regen-image-btn');
    if (regenImgBtn) {
      regenImgBtn.addEventListener('click', async () => {
        if (!confirm('Regenerate hero image with Runware FLUX.1 Schnell?')) return;
        regenImgBtn.disabled = true;
        regenImgBtn.textContent = 'Generating...';
        try {
          const res = await fetch('/api/editorial/regenerate-image', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipeId })
          });
          const data = await res.json();
          if (data.success) {
            alert('Hero image regenerated!');
            window.location.reload();
          } else {
            alert('Image generation failed: ' + data.error);
            regenImgBtn.disabled = false;
            regenImgBtn.textContent = '↺ Regenerate Image';
          }
        } catch (e) {
          alert('Network error generating image.');
          regenImgBtn.disabled = false;
        }
      });
    }

    // Section Edit / Regenerate Helpers (Global scope for onclick handlers)
    window.toggleEditSection = function(section) {
      const viewEl = document.getElementById(`view-${section}`);
      const editEl = document.getElementById(`edit-${section}`);
      if (viewEl && editEl) {
        viewEl.classList.toggle('hidden');
        editEl.classList.toggle('hidden');
      }
    };

    window.saveSectionContent = async function(section, isJson = false) {
      const editEl = document.getElementById(`edit-${section}`);
      const textarea = editEl?.querySelector('textarea');
      if (!textarea) return;
      let val = textarea.value;
      if (isJson) {
        try { val = JSON.parse(val); } catch (e) { return alert('Invalid JSON syntax: ' + e.message); }
      }

      try {
        const res = await fetch('/api/editorial/update-content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId, section, value: val })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('Failed to save section: ' + data.error);
        }
      } catch (e) {
        alert('Network error saving section.');
      }
    };

    window.saveSectionLines = async function(section) {
      const editEl = document.getElementById(`edit-${section}`);
      const textarea = editEl?.querySelector('textarea');
      if (!textarea) return;
      const lines = textarea.value.split('\n').map(l => l.trim()).filter(Boolean);

      try {
        const res = await fetch('/api/editorial/update-content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId, section, value: lines })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('Failed to save section: ' + data.error);
        }
      } catch (e) {
        alert('Network error saving section.');
      }
    };

    window.saveStorageServing = async function() {
      const sInput = document.getElementById('edit-serving-input');
      const stInput = document.getElementById('edit-storage-input');
      try {
        await fetch('/api/editorial/update-content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recipeId,
            fullContent: {
              serving_suggestions: sInput?.value || '',
              storage: stInput?.value || ''
            }
          })
        });
        window.location.reload();
      } catch (e) {
        alert('Network error saving storage/serving.');
      }
    };

    window.regenerateSpecificSection = async function(section) {
      if (!confirm(`Regenerate section "${section}" with DeepSeek AI? This preserves other sections.`)) return;
      const btn = document.querySelector(`#sec-${section} .btn-regen`);
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Generating...';
      }

      try {
        const res = await fetch('/api/editorial/regenerate-section', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId, section })
        });
        const data = await res.json();
        if (data.success) {
          alert(`Section "${section}" regenerated!`);
          window.location.reload();
        } else {
          alert('Regeneration failed: ' + data.error);
          if (btn) {
            btn.disabled = false;
            btn.textContent = '↺ Regenerate';
          }
        }
      } catch (e) {
        alert('Network error regenerating section.');
        if (btn) {
          btn.disabled = false;
          btn.textContent = '↺ Regenerate';
        }
      }
    };
  </script>

  <style>
    .provenance-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
    }
    .provenance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .prov-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .prov-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #64748b;
    }
    .prov-val {
      font-size: 0.88rem;
      font-weight: 600;
      color: #1e293b;
    }
    .prov-badge {
      display: inline-block;
      width: fit-content;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .badge-high { background: #dcfce7; color: #15803d; }
    .badge-medium { background: #fef9c3; color: #a16207; }
    .badge-low { background: #fee2e2; color: #b91c1c; }
    .prov-source {
      font-size: 0.8rem;
      color: #64748b;
      word-break: break-all;
    }
    .source-url-link {
      color: #2563eb;
      text-decoration: none;
      margin-left: 0.35rem;
    }
    .source-url-link:hover {
      text-decoration: underline;
    }
    .extraction-warning {
      margin-top: 0.75rem;
      padding: 0.6rem 0.85rem;
      background: #fffbeb;
      border: 1px solid #fef08a;
      border-radius: 6px;
      color: #854d0e;
      font-size: 0.85rem;
    }
  </style>
</AdminLayout>
