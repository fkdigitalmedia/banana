---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getRecipeWithAllDetails, getCategories, getJobByRecipeId } from '../../../lib/db/recipes';
import { validateTechnicalSeo, analyzeInternalLinks, getRedirectHistory } from '../../../lib/seo';

const env = Astro.locals.runtime.env;
const db = env.DB;
const recipeId = parseInt(Astro.params.id || '0', 10);
const siteUrl = env.SITE_URL || 'https://yoursite.com';

const [recipe, categories, latestJob] = await Promise.all([
  getRecipeWithAllDetails(db, recipeId),
  getCategories(db),
  getJobByRecipeId(db, recipeId)
]);

if (!recipe) {
  return Astro.redirect('/admin/recipes/');
}

const [linkAnalysis, redirectsHistory, imageRecords] = await Promise.all([
  analyzeInternalLinks(db, recipe.id, recipe.slug, recipe.category_id, recipe.cuisine),
  getRedirectHistory(db, recipe.id),
  db.prepare('SELECT * FROM recipe_images WHERE recipe_id = ? ORDER BY id DESC').bind(recipe.id).all<any>()
]);

const recipeImages = imageRecords?.results || [];
const sourceImage = recipeImages.find((img: any) => img.type === 'SOURCE' && (img.placement === 'HERO' || !img.placement)) || recipeImages.find((img: any) => img.type === 'SOURCE');
const generatedImage = recipeImages.find((img: any) => img.type === 'GENERATED');
const seenAdminKeys = new Set<string>();
const inArticleImages = recipeImages.filter((img: any) => {
  if (img.type !== 'SOURCE' || img.status !== 'READY') return false;
  if (img.placement === 'HERO' || img.r2_key === recipe.hero_image_key || img.r2_key === sourceImage?.r2_key) return false;
  if (seenAdminKeys.has(img.r2_key)) return false;
  seenAdminKeys.add(img.r2_key);
  return true;
});

const content = recipe.content || {};
const seo = recipe.seo || {};

let qualityReport: any = null;
if (recipe.quality_report) {
  try {
    qualityReport = typeof recipe.quality_report === 'string' ? JSON.parse(recipe.quality_report) : recipe.quality_report;
  } catch {
    qualityReport = null;
  }
}
const qualityScore = recipe.quality_score ?? qualityReport?.score ?? 100;
const qualityStatus = recipe.quality_status || (qualityScore >= 80 ? 'QUALITY_PASSED' : 'QUALITY_REVIEW');

const seoReport = validateTechnicalSeo(
  recipe,
  recipe.ingredients || [],
  recipe.instructions || [],
  content,
  seo,
  siteUrl,
  { incomingLinksCount: linkAnalysis?.incomingLinksCount }
);

// Format ingredients for editing / locked display
const ingredientsList = (recipe.ingredients || [])
  .map((i: any) => i.original_text || `${i.quantity || ''} ${i.unit || ''} ${i.name || ''} ${i.notes ? `(${i.notes})` : ''}`.trim())
  .join('\n');

const instructionsList = (recipe.instructions || [])
  .map((i: any) => `${i.step_number}. ${i.instruction || i.text}`)
  .join('\n');

let parsedIngGuidance = '';
if (content.ingredient_guidance) {
  try {
    const arr = typeof content.ingredient_guidance === 'string' ? JSON.parse(content.ingredient_guidance) : content.ingredient_guidance;
    parsedIngGuidance = Array.isArray(arr) ? arr.map((item: any) => `### ${item.ingredient}\n${item.guidance}`).join('\n\n') : String(content.ingredient_guidance);
  } catch { parsedIngGuidance = String(content.ingredient_guidance); }
}

let parsedCookingGuidance = '';
if (content.cooking_guidance) {
  try {
    const arr = typeof content.cooking_guidance === 'string' ? JSON.parse(content.cooking_guidance) : content.cooking_guidance;
    parsedCookingGuidance = Array.isArray(arr) ? arr.join('\n\n') : String(content.cooking_guidance);
  } catch { parsedCookingGuidance = String(content.cooking_guidance); }
}

let parsedTips = '';
if (content.tips) {
  try {
    const arr = typeof content.tips === 'string' ? JSON.parse(content.tips) : content.tips;
    parsedTips = Array.isArray(arr) ? arr.join('\n') : String(content.tips);
  } catch { parsedTips = String(content.tips); }
}

let parsedVariations = '';
if (content.variations) {
  try {
    const arr = typeof content.variations === 'string' ? JSON.parse(content.variations) : content.variations;
    parsedVariations = Array.isArray(arr) ? arr.map((v: any) => `### ${v.name}\n${v.description}`).join('\n\n') : String(content.variations);
  } catch { parsedVariations = String(content.variations); }
}

let parsedFaq = '';
if (content.faq) {
  try {
    const arr = typeof content.faq === 'string' ? JSON.parse(content.faq) : content.faq;
    parsedFaq = Array.isArray(arr) ? arr.map((f: any) => `Q: ${f.question}\nA: ${f.answer}`).join('\n\n') : String(content.faq);
  } catch { parsedFaq = String(content.faq); }
}
---

<AdminLayout title={`Edit: ${recipe.title}`} activePage="recipes">
  <div class="editor-header">
    <div class="breadcrumb">
      <a href="/admin/recipes/">← Back to Recipes</a>
      <span class="divider">/</span>
      <span class={`status-pill status-${(recipe.status || 'imported').toLowerCase()}`}>{recipe.status}</span>
    </div>
    <div class="actions">
      <button id="btn-validate" type="button" class="btn btn-secondary">🔍 Validate Facts</button>
      <button id="btn-save-draft" type="button" class="btn btn-secondary">💾 Save Changes</button>
      {recipe.status === 'PUBLISHED' ? (
        <>
          <a href={`/${recipe.slug}/`} target="_blank" class="btn btn-secondary">🌐 View Live</a>
          <button id="btn-unpublish" type="button" class="btn btn-warning-outline">↩ Unpublish</button>
        </>
      ) : (
        <>
          <a href={`/${recipe.slug}/?preview=true`} target="_blank" class="btn btn-secondary">👁️ Preview Draft</a>
          {recipe.status !== 'APPROVED' && (
            <button id="btn-approve" type="button" class="btn btn-secondary" style="border-color: #16a34a; color: #16a34a; font-weight: 600;">✓ Approve</button>
          )}
          <button id="btn-publish" type="button" class="btn btn-success">🚀 Publish Recipe</button>
        </>
      )}
      <button id="btn-delete-recipe" type="button" class="btn btn-danger-outline">🗑️</button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast hidden"></div>

  <!-- Fact Change Warning Banner -->
  <div id="fact-warning-banner" class="fact-warning-banner hidden">
    ⚠️ <strong>Recipe Facts Modified:</strong> Structured ingredients, times, or instructions have changed. Re-run <strong>🔍 Validate Facts</strong> or regenerate sections to ensure editorial content stays factually accurate.
  </div>

  <!-- Generate Article Banner -->
  <div class="generate-hero-card">
    <div class="generate-info">
      <div class="ai-badge">🤖 DeepSeek Editorial Engine</div>
      <h2>{recipe.status === 'IMPORTED' ? 'Ready for Original Editorial Generation' : 'DeepSeek Content Generation'}</h2>
      <p>Transform structured recipe facts into a complete, original, and SEO-optimized recipe article with independent culinary analysis.</p>
    </div>
    <div class="generate-action">
      <button id="btn-start-generation" type="button" class="btn-generate-large">
        ✨ {recipe.status === 'IMPORTED' ? 'Generate Full Article' : 'Regenerate Full Article'}
      </button>
    </div>
  </div>

  <!-- Generation Progress Modal -->
  <div id="generation-modal" class="modal-backdrop hidden">
    <div class="modal-card">
      <div class="modal-header">
        <h3>🤖 DeepSeek Editorial Generation</h3>
        <span id="generation-status-text" class="status-running">In Progress...</span>
      </div>
      <p class="modal-desc">Generating high-value original editorial content from locked recipe facts. Please wait...</p>
      
      <ul id="generation-stages-list" class="generation-stages">
        <li data-stage="1" class="stage-item"><span class="stage-icon">⏳</span> 1. Editorial & Positioning Analysis</li>
        <li data-stage="2" class="stage-item"><span class="stage-icon">⏳</span> 2. Engaging Introduction & Hook</li>
        <li data-stage="3" class="stage-item"><span class="stage-icon">⏳</span> 3. Ingredient Science & Guidance</li>
        <li data-stage="4" class="stage-item"><span class="stage-icon">⏳</span> 4. Cooking Technique Guidance</li>
        <li data-stage="5" class="stage-item"><span class="stage-icon">⏳</span> 5. Practical Pro Baking Tips</li>
        <li data-stage="6" class="stage-item"><span class="stage-icon">⏳</span> 6. Optional Mix-ins & Variations</li>
        <li data-stage="7" class="stage-item"><span class="stage-icon">⏳</span> 7. Serving Suggestions & Pairings</li>
        <li data-stage="8" class="stage-item"><span class="stage-icon">⏳</span> 8. Storage & Reheating Instructions</li>
        <li data-stage="9" class="stage-item"><span class="stage-icon">⏳</span> 9. Recipe-Specific Reader FAQ</li>
        <li data-stage="10" class="stage-item"><span class="stage-icon">⏳</span> 10. SEO Title, Description & Keywords</li>
        <li data-stage="11" class="stage-item"><span class="stage-icon">⏳</span> 11. Full Article Assembly</li>
        <li data-stage="12" class="stage-item"><span class="stage-icon">⏳</span> 12. Factual Integrity Validation</li>
        <li data-stage="13" class="stage-item"><span class="stage-icon">⏳</span> 13. Ready as Draft</li>
      </ul>

      <div id="modal-error-msg" class="modal-error hidden"></div>

      <div class="modal-footer">
        <button id="btn-close-modal" type="button" class="btn btn-secondary hidden">Close</button>
        <button id="btn-retry-stage" type="button" class="btn btn-warning hidden">↻ Retry Failed Stage</button>
        <button id="btn-reload-page" type="button" class="btn btn-primary hidden">Review Draft →</button>
      </div>
    </div>
  </div>

  <!-- Validation Issues Alert Box -->
  <div id="validation-panel" class="validation-panel hidden">
    <div class="validation-header">
      <h4>🔍 Factual Validation Report</h4>
      <button id="btn-close-val" type="button" class="close-btn">×</button>
    </div>
    <ul id="validation-list" class="validation-list"></ul>
  </div>

  <form id="recipe-editor-form" class="editor-grid">
    
    <!-- Left Column: AI Editorial Content -->
    <div class="main-column">
      
      <div class="section-divider-title">
        <span>✍️ AI GENERATED EDITORIAL CONTENT</span>
      </div>

      <!-- Basic Info -->
      <div class="card">
        <h3>Basic Information</h3>
        <div class="form-group">
          <label for="title">Recipe Title</label>
          <input type="text" id="title" name="title" value={recipe.title} class="form-control" required />
        </div>
        <div class="form-group">
          <label for="slug">URL Slug</label>
          <div class="slug-input-wrapper">
            <span class="slug-prefix">/</span>
            <input type="text" id="slug" name="slug" value={recipe.slug} class="form-control slug-input" required />
            <span class="slug-suffix">/</span>
          </div>
        </div>
        <div class="form-group">
          <label for="description">Short Description / Excerpt</label>
          <textarea id="description" name="description" class="form-control" rows="3">{recipe.description}</textarea>
        </div>
      </div>

      <!-- Introduction & Why This Recipe -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Introduction & Why You'll Love It</h3>
            <p class="card-subtitle">Original hook and editorial summary of recipe highlights.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="introduction">↺ Regenerate Intro</button>
        </div>
        <div class="form-group">
          <label for="introduction">Introduction Text</label>
          <textarea id="introduction" name="introduction" class="form-control" rows="6">{content.introduction || ''}</textarea>
        </div>
        <div class="form-group">
          <label for="why_this_recipe">Why You'll Love This Recipe</label>
          <textarea id="why_this_recipe" name="why_this_recipe" class="form-control" rows="4">{content.why_this_recipe || ''}</textarea>
        </div>
      </div>

      <!-- Ingredient Guidance -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Ingredient Guidance</h3>
            <p class="card-subtitle">Culinary advice on selection, temperature, and role of key ingredients.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="ingredientGuidance">↺ Regenerate Guidance</button>
        </div>
        <textarea id="ingredient_guidance" name="ingredient_guidance" class="form-control" rows="8">{parsedIngGuidance}</textarea>
      </div>

      <!-- Cooking Guidance -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Cooking & Technique Guidance</h3>
            <p class="card-subtitle">Step-by-step technique explanations, sensory cues, and doneness tests.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="cookingGuidance">↺ Regenerate Cooking</button>
        </div>
        <textarea id="cooking_guidance" name="cooking_guidance" class="form-control" rows="8">{parsedCookingGuidance}</textarea>
      </div>

      <!-- Pro Baking Tips -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Pro Baking Tips</h3>
            <p class="card-subtitle">Actionable tips to ensure consistent results every time.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="tips">↺ Regenerate Tips</button>
        </div>
        <textarea id="tips" name="tips" class="form-control" rows="8">{parsedTips}</textarea>
      </div>

      <!-- Optional Variations -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Flavor & Mix-In Variations</h3>
            <p class="card-subtitle">Optional additions that keep the base recipe intact.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="variations">↺ Regenerate Variations</button>
        </div>
        <textarea id="variations" name="variations" class="form-control" rows="8">{parsedVariations}</textarea>
      </div>

      <!-- Serving & Storage -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Serving & Storage Instructions</h3>
            <p class="card-subtitle">Pairing recommendations, room temperature, freezing, and reheating.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="storage">↺ Regenerate Storage</button>
        </div>
        <div class="form-group">
          <label for="serving_suggestions">Serving Suggestions</label>
          <textarea id="serving_suggestions" name="serving_suggestions" class="form-control" rows="4">{content.serving_suggestions || ''}</textarea>
        </div>
        <div class="form-group">
          <label for="storage">Storage & Reheating</label>
          <textarea id="storage" name="storage" class="form-control" rows="6">{content.storage || ''}</textarea>
        </div>
      </div>

      <!-- FAQ -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Frequently Asked Questions</h3>
            <p class="card-subtitle">Insightful answers to common questions asked by home bakers.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="faq">↺ Regenerate FAQ</button>
        </div>
        <textarea id="faq" name="faq" class="form-control" rows="10">{parsedFaq}</textarea>
      </div>

      <!-- Assembled Full Article -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3>Assembled Article (Markdown)</h3>
            <p class="card-subtitle">Cohesive full-text article including all headings, editorial, and structure.</p>
          </div>
          <button type="button" class="btn-regenerate" data-section="assembly">↺ Reassemble Article</button>
        </div>
        <textarea id="full_article" name="full_article" class="form-control font-mono" rows="14">{content.full_article || ''}</textarea>
      </div>

    </div>

    <!-- Right Column: Locked Facts, Source & SEO -->
    <div class="side-column">

      <div class="section-divider-title">
        <span>🔒 LOCKED RECIPE FACTS</span>
      </div>

      <!-- Locked Facts Card -->
      <div class="card locked-card">
        <div class="locked-header">
          <div class="locked-title-group">
            <span class="locked-icon">🔒</span>
            <h3>Locked Recipe Facts</h3>
          </div>
          <button type="button" id="btn-toggle-fact-edit" class="btn-edit-facts">✏️ Edit Facts</button>
        </div>
        <p class="locked-sub">Authoritative source data. AI editorial strictly adheres to these values.</p>
        
        <div class="locked-meta-grid">
          <div><span class="label">Prep:</span> <strong>{recipe.prep_time || '—'}m</strong></div>
          <div><span class="label">Cook:</span> <strong>{recipe.cook_time || '—'}m</strong></div>
          <div><span class="label">Total:</span> <strong>{recipe.total_time || '—'}m</strong></div>
          <div><span class="label">Yield:</span> <strong>{recipe.servings || '—'}</strong></div>
        </div>

        <div class="form-group mt-3">
          <label for="ingredients">Ingredients List (one per line)</label>
          <textarea id="ingredients" name="ingredients" class="form-control facts-textarea" rows="8" readonly>{ingredientsList}</textarea>
        </div>

        <div class="form-group">
          <label for="instructions">Instructions (step-by-step)</label>
          <textarea id="instructions" name="instructions" class="form-control facts-textarea" rows="8" readonly>{instructionsList}</textarea>
        </div>
      </div>

      <!-- Recipe Images & Hero Management Card -->
      <div class="card recipe-images-card">
        <div class="card-header">
          <div>
            <h3>Recipe Images & Hero</h3>
            <span class="card-subtitle">Manage source photo, AI visuals & hero presentation</span>
          </div>
          <span class={`status-pill ${recipe.hero_image_key ? 'status-published' : 'status-draft'}`}>
            {recipe.hero_image_key ? `ACTIVE: ${recipe.hero_image_type || 'SOURCE'}` : 'NO ACTIVE HERO'}
          </span>
        </div>

        <!-- Active Hero Preview -->
        <div class="hero-preview-box">
          <span class="preview-tag">Currently Active Hero (Public Page)</span>
          {recipe.hero_image_key ? (
            <div class="hero-preview-content">
              <img src={`/api/image/${recipe.hero_image_key}`} alt={recipe.title} class="hero-img-display" />
              <div class="hero-details">
                <div class="hero-detail-item"><strong>Type:</strong> <span class="badge-tag">{recipe.hero_image_type || 'SOURCE'}</span></div>
                <div class="hero-detail-item"><strong>R2 Key:</strong> <code class="code-truncate">{recipe.hero_image_key}</code></div>
                <div class="hero-detail-item">
                  <strong>Rights Status:</strong>
                  <span class={`rights-badge rights-${(recipe.image_rights_status || 'review_required').toLowerCase()}`}>
                    {recipe.image_rights_status || 'REVIEW_REQUIRED'}
                  </span>
                </div>
              </div>
            </div>
          ) : (
            <div class="hero-placeholder-box">
              <span style="font-size: 2rem;">🖼️</span>
              <p>No active hero image. Public page uses fallback placeholder.</p>
            </div>
          )}
        </div>

        <!-- Available Images Grid -->
        <div class="image-options-grid">
          <!-- 1. Source Image Option -->
          <div class={`img-option-card ${recipe.hero_image_type === 'SOURCE' && recipe.hero_image_key ? 'active-option' : ''}`}>
            <div class="option-header">
              <span class="option-title">📸 Source Photo</span>
              <span class={`status-pill status-${(recipe.source_image_status || 'pending').toLowerCase()}`}>
                {recipe.source_image_status || 'PENDING'}
              </span>
            </div>

            {sourceImage?.r2_key ? (
              <div class="option-body">
                <img src={`/api/image/${sourceImage.r2_key}`} alt="Source recipe photo" class="thumb-img" />
                <div class="option-meta">
                  <span>{sourceImage.width}×{sourceImage.height} ({sourceImage.mime_type?.replace('image/', '')})</span>
                  <span>{Math.round((sourceImage.file_size || 0) / 1024)} KB</span>
                  <div class="rights-selector-group">
                    <label for="source-rights-select" class="text-xs">Rights:</label>
                    <select id="source-rights-select" class="form-control select-rights-status" data-recipe-id={recipe.id}>
                      <option value="REVIEW_REQUIRED" selected={recipe.image_rights_status === 'REVIEW_REQUIRED'}>Review Required</option>
                      <option value="APPROVED" selected={recipe.image_rights_status === 'APPROVED'}>Approved</option>
                      <option value="UNKNOWN" selected={recipe.image_rights_status === 'UNKNOWN'}>Unknown</option>
                    </select>
                  </div>
                </div>
                <div class="option-actions">
                  {recipe.hero_image_key !== sourceImage.r2_key ? (
                    <button type="button" class="btn btn-primary btn-sm btn-use-image" data-type="SOURCE" data-id={recipe.id}>
                      ✓ Use as Hero
                    </button>
                  ) : (
                    <span class="active-label">✓ Active Hero</span>
                  )}
                  <button type="button" class="btn btn-secondary btn-sm btn-reimport-source" data-id={recipe.id}>
                    ↻ Re-import
                  </button>
                </div>
              </div>
            ) : (
              <div class="option-empty">
                <p class="text-sm text-muted">
                  {recipe.original_image_url ? 'Original source image URL detected.' : 'No source image found in recipe.'}
                </p>
                {recipe.original_image_url && (
                  <button type="button" class="btn btn-secondary btn-sm btn-reimport-source" data-id={recipe.id}>
                    📥 Import to R2
                  </button>
                )}
              </div>
            )}
          </div>

          <!-- 2. AI Generated Image Option -->
          <div class={`img-option-card ${recipe.hero_image_type === 'GENERATED' && recipe.hero_image_key ? 'active-option' : ''}`}>
            <div class="option-header">
              <span class="option-title">🎨 AI Generated Photo</span>
              <span class={`status-pill status-${(generatedImage ? 'published' : (recipe.image_status || 'pending')).toLowerCase()}`}>
                {generatedImage ? 'READY' : (recipe.image_status || 'PENDING')}
              </span>
            </div>

            {generatedImage?.r2_key ? (
              <div class="option-body">
                <img src={`/api/image/${generatedImage.r2_key}`} alt="AI Generated Hero" class="thumb-img" />
                <div class="option-meta">
                  <span>FLUX.1 Schnell ({generatedImage.width}×{generatedImage.height})</span>
                  <span>Rights: <strong class="text-success">APPROVED</strong></span>
                </div>
                <div class="option-actions">
                  {recipe.hero_image_key !== generatedImage.r2_key ? (
                    <button type="button" class="btn btn-primary btn-sm btn-use-image" data-type="GENERATED" data-id={recipe.id}>
                      ✓ Use as Hero
                    </button>
                  ) : (
                    <span class="active-label">✓ Active Hero</span>
                  )}
                  <button type="button" class="btn btn-secondary btn-sm btn-generate-ai-img" data-id={recipe.id}>
                    ✨ Regenerate AI
                  </button>
                </div>
              </div>
            ) : (
              <div class="option-empty">
                <p class="text-sm text-muted">No AI photo generated yet.</p>
                <button type="button" class="btn btn-primary btn-sm btn-generate-ai-img" data-id={recipe.id}>
                  ✨ Generate with FLUX.1
                </button>
              </div>
            )}
          </div>
        </div>

        {inArticleImages.length > 0 && (
          <div class="in-article-images-manager" style="margin-top: 1.5rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <div>
                <h4 style="margin: 0; font-size: 1rem; color: #1e293b;">🖼️ In-Article Process Photos ({inArticleImages.length})</h4>
                <p style="margin: 0.25rem 0 0; font-size: 0.825rem; color: #64748b;">
                  These step-by-step photos were automatically extracted and stored in R2. They display in the article's Visual Guide section.
                </p>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
              {inArticleImages.map((pImg: any, pIdx: number) => (
                <div style="border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; background: #f8fafc;">
                  <div style="position: relative; aspect-ratio: 4/3; background: #eee;">
                    <img src={`/api/image/${pImg.r2_key}`} alt={pImg.alt_text || 'Process photo'} style="width: 100%; height: 100%; object-fit: cover;" />
                    <span style="position: absolute; top: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">
                      {pImg.step_number ? `Step ${pImg.step_number}` : `Photo #${pIdx + 1}`}
                    </span>
                  </div>
                  <div style="padding: 0.6rem; font-size: 0.75rem;">
                    <div style="color: #64748b; margin-bottom: 4px;">{pImg.width}×{pImg.height} • {Math.round((pImg.file_size || 0) / 1024)} KB</div>
                    <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #334155;" title={pImg.alt_text}>{pImg.alt_text || 'Process photo'}</div>
                    <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                      {recipe.hero_image_key !== pImg.r2_key ? (
                        <button type="button" class="btn btn-secondary btn-sm btn-use-image" data-type="SOURCE" data-key={pImg.r2_key} data-id={recipe.id} style="font-size: 0.7rem; padding: 2px 6px;">
                          Set as Hero
                        </button>
                      ) : (
                        <span style="color: #16a34a; font-weight: bold; font-size: 0.7rem;">✓ Active Hero</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Source Information Card -->
      <div class="card">
        <h3>Source & Extraction Data</h3>
        <div class="source-details">
          <div class="detail-row">
            <span class="detail-label">Source URL:</span>
            {recipe.source_url ? (
              <a href={recipe.source_url} target="_blank" rel="noopener" class="detail-val link-truncate">
                {recipe.source_domain || recipe.source_url} ↗
              </a>
            ) : (
              <span class="detail-val">Direct Entry</span>
            )}
          </div>
          <div class="detail-row">
            <span class="detail-label">Extraction:</span>
            <span class="badge-tag">{recipe.extraction_method || 'JSON-LD'}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Confidence:</span>
            <span class="badge-tag text-success">{recipe.extraction_confidence || 'HIGH'}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Imported:</span>
            <span class="detail-val">{new Date(recipe.created_at).toLocaleString()}</span>
          </div>
        </div>
      </div>

      <!-- Categorization & Timings -->
      <div class="card">
        <h3>Categorization & Timings</h3>
        <div class="form-group">
          <label for="category_id">Category</label>
          <select id="category_id" name="category_id" class="form-control">
            <option value="">Select Category</option>
            {categories.map((c: any) => (
              <option value={c.id} selected={c.id === recipe.category_id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label for="cuisine">Cuisine</label>
            <input type="text" id="cuisine" name="cuisine" value={recipe.cuisine || ''} class="form-control" />
          </div>
          <div class="form-group">
            <label for="servings">Servings / Yield</label>
            <input type="text" id="servings" name="servings" value={recipe.servings || ''} class="form-control fact-input" />
          </div>
        </div>
        <div class="grid-3">
          <div class="form-group">
            <label for="prep_time">Prep (m)</label>
            <input type="number" id="prep_time" name="prep_time" value={recipe.prep_time || ''} class="form-control fact-input" />
          </div>
          <div class="form-group">
            <label for="cook_time">Cook (m)</label>
            <input type="number" id="cook_time" name="cook_time" value={recipe.cook_time || ''} class="form-control fact-input" />
          </div>
          <div class="form-group">
            <label for="total_time">Total (m)</label>
            <input type="number" id="total_time" name="total_time" value={recipe.total_time || ''} class="form-control fact-input" />
          </div>
        </div>
      </div>

      <!-- Content Quality & Fact-Consistency Card -->
      <div class="card quality-panel-card">
        <div class="card-header">
          <h3>Content Quality</h3>
          <span class={`status-badge-mini status-${qualityStatus.toLowerCase().replace('quality_', '')}`}>
            {qualityScore}/100 — {qualityStatus.replace('QUALITY_', '')}
          </span>
        </div>

        <div class="quality-checks-list">
          <div class="quality-check-item">
            <span class="q-icon">✓</span>
            <span>Fact & Ingredient Consistency</span>
          </div>
          <div class="quality-check-item">
            <span class="q-icon">✓</span>
            <span>Temperature & Cook Times</span>
          </div>
          <div class="quality-check-item">
            <span class="q-icon">✓</span>
            <span>Recipe Specificity (Sensory Cues)</span>
          </div>
          <div class="quality-check-item">
            <span class="q-icon">✓</span>
            <span>Zero Cross-Section Duplication</span>
          </div>
          <div class="quality-check-item">
            <span class="q-icon">✓</span>
            <span>Natural SEO & Zero Cliches</span>
          </div>
        </div>

        {qualityReport?.issues && qualityReport.issues.length > 0 && (
          <div class="quality-issues-container">
            <div class="issues-header-row">
              <h4 class="issues-title">Detected Quality Flags ({qualityReport.issues.length})</h4>
              <button type="button" id="btn-solve-issues-header" class="btn-solve-mini">
                ✨ Solve Issues
              </button>
            </div>
            <ul class="issues-list">
              {qualityReport.issues.map((issue: any, idx: number) => (
                <li class={`issue-item severity-${(issue.severity || 'low').toLowerCase()}`}>
                  <span class="issue-badge">{issue.severity}</span>
                  <div class="issue-body">
                    <p class="issue-msg">{issue.message}</p>
                    {issue.expected && (
                      <div class="issue-diff">
                        <span>Expected: <code>{issue.expected}</code></span>
                        {issue.found && <span>Found: <code>{issue.found}</code></span>}
                      </div>
                    )}
                  </div>
                  <button 
                    type="button" 
                    class="btn-solve-single-issue" 
                    data-issue-index={idx}
                    data-issue-type={issue.type}
                    title="Auto-solve this issue"
                  >
                    Solve ⚡
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="quality-actions">
          {qualityReport?.issues && qualityReport.issues.length > 0 && (
            <button type="button" id="btn-auto-fix-issues" class="btn-auto-fix-action">
              ✨ Auto-Fix & Solve Issues
            </button>
          )}
          <button type="button" id="btn-run-quality-check" class="btn-quality-action">
            🔍 Re-run Quality Assessment
          </button>
        </div>
      </div>

      <!-- Pipeline Execution Card -->
      <div class="card pipeline-panel-card">
        <div class="card-header">
          <h3>Pipeline Execution</h3>
          <span class={`status-badge-mini status-${(latestJob?.status || (recipe.status === 'PUBLISHED' ? 'completed' : 'ready')).toLowerCase()}`}>
            {latestJob?.status || (recipe.status === 'PUBLISHED' ? 'COMPLETED' : 'DRAFT_READY')}
          </span>
        </div>

        <div class="pipeline-stages-compact">
          <div class="p-stage-row passed">
            <span class="p-check">✓</span>
            <span>URL Extraction & Fact Locking</span>
          </div>
          <div class={`p-stage-row ${recipe.content ? 'passed' : 'pending'}`}>
            <span class="p-check">{recipe.content ? '✓' : '○'}</span>
            <span>DeepSeek AI Editorial Generation</span>
          </div>
          <div class={`p-stage-row ${qualityReport ? 'passed' : 'pending'}`}>
            <span class="p-check">{qualityReport ? '✓' : '○'}</span>
            <span>Content Quality & Consistency</span>
          </div>
          <div class={`p-stage-row ${recipe.hero_image_key ? 'passed' : 'pending'}`}>
            <span class="p-check">{recipe.hero_image_key ? '✓' : '○'}</span>
            <span>FLUX.1 Schnell Hero Image</span>
          </div>
          <div class={`p-stage-row ${recipe.status === 'PUBLISHED' ? 'passed' : 'ready'}`}>
            <span class="p-check">{recipe.status === 'PUBLISHED' ? '✓' : '●'}</span>
            <span>{recipe.status === 'PUBLISHED' ? 'Published' : 'Draft Ready for Review'}</span>
          </div>
        </div>

        {latestJob?.error_message && (
          <div class="pipeline-error-box">
            <strong>Failed at {latestJob.current_stage}:</strong>
            <p>{latestJob.error_message}</p>
            <a href={`/admin/import/?retryJobId=${latestJob.id}`} class="btn-retry-pipeline">↻ Retry Pipeline</a>
          </div>
        )}
      </div>

      <!-- SEO & Technical Search Readiness -->
      <div class="card seo-panel-card">
        <div class="card-header">
          <div>
            <h3>SEO & Search Readiness</h3>
            <span class={`score-pill score-${seoReport.score >= 85 ? 'high' : (seoReport.score >= 70 ? 'med' : 'low')}`}>
              SEO Readiness: {seoReport.score}/100
            </span>
          </div>
          <button type="button" class="btn-regenerate" data-section="seo">↺ Regenerate SEO</button>
        </div>

        <div class="form-group">
          <label for="seo_title">SEO Title</label>
          <input type="text" id="seo_title" name="seo_title" value={seo.seo_title || recipe.title} class="form-control" />
          <span class="char-count" id="title-char-count">0/60 chars</span>
        </div>
        <div class="form-group">
          <label for="meta_description">Meta Description</label>
          <textarea id="meta_description" name="meta_description" class="form-control" rows="3">{seo.meta_description || recipe.description || ''}</textarea>
          <span class="char-count" id="desc-char-count">0/155 chars</span>
        </div>

        <!-- Google SERP Snippet Preview -->
        <div class="serp-preview">
          <span class="serp-label">Google Search Preview</span>
          <div class="serp-url">{seoReport.canonicalUrl}</div>
          <div class="serp-title" id="serp-title-preview">{seo.seo_title || recipe.title}</div>
          <div class="serp-desc" id="serp-desc-preview">{seo.meta_description || recipe.description || 'Learn how to make this delicious recipe...'}</div>
        </div>

        <!-- Technical Health Checklist -->
        <div class="seo-health-grid">
          <div class="seo-health-item">
            <span class="health-label">Indexability:</span>
            <span class={`health-value ${seoReport.indexability === 'INDEXABLE' ? 'text-success' : 'text-warning'}`}>
              {seoReport.indexability}
            </span>
          </div>
          <div class="seo-health-item">
            <span class="health-label">Search Console:</span>
            <span class="health-value text-muted">Not connected</span>
          </div>
          <div class="seo-health-item">
            <span class="health-label">Internal Links:</span>
            <span class={`health-value ${linkAnalysis?.isOrphan ? 'text-danger' : 'text-success'}`}>
              {linkAnalysis?.incomingLinksCount || 0} incoming ({linkAnalysis?.status || 'DISCOVERABLE'})
            </span>
          </div>
          <div class="seo-health-item">
            <span class="health-label">Canonical:</span>
            <span class="health-value link-truncate">{seoReport.canonicalUrl}</span>
          </div>
        </div>

        {seoReport.issues.length > 0 && (
          <div class="seo-issues-box">
            <h4 class="seo-issues-title">SEO Attention Items ({seoReport.issues.length})</h4>
            <ul class="seo-issues-list">
              {seoReport.issues.map((issue: any) => (
                <li class={`seo-issue-row level-${issue.level.toLowerCase()}`}>
                  <span class="issue-badge">{issue.level}</span>
                  <div class="issue-text">
                    <p class="issue-msg">{issue.message}</p>
                    {issue.recommendation && <p class="issue-rec">💡 {issue.recommendation}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        {redirectsHistory && redirectsHistory.length > 0 && (
          <div class="redirects-history-box">
            <h4>🔄 Slug Change Redirects (301)</h4>
            <ul class="redirect-list">
              {redirectsHistory.map((r: any) => (
                <li class="redirect-item">
                  <code>/{r.old_slug}/</code> ➔ <code>/{r.target_slug}/</code>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Media Panel with Runware FLUX.1 Schnell Integration -->
      <div class="card image-panel-card">
        <div class="card-header">
          <h3>Recipe Hero Image</h3>
          <span class={`status-badge-mini status-${(recipe.image_status || (recipe.hero_image_key ? 'ready' : 'pending')).toLowerCase()}`}>
            {recipe.image_status || (recipe.hero_image_key ? 'READY' : 'PENDING')}
          </span>
        </div>

        <div class="image-preview-wrapper" id="image-preview-box">
          {recipe.hero_image_key ? (
            <img src={`/api/image/${recipe.hero_image_key}`} alt={recipe.title} class="image-preview" id="hero-img-element" />
          ) : recipe.original_image_url ? (
            <img src={recipe.original_image_url} alt={recipe.title} class="image-preview" id="hero-img-element" />
          ) : (
            <div class="image-placeholder" id="hero-img-placeholder">
              <span>🖼️ No Hero Image Available</span>
            </div>
          )}
        </div>

        <div class="image-meta-details">
          <div class="meta-row">
            <span class="meta-title">AI Provider:</span>
            <span class="meta-value">{recipe.image_provider || 'Runware'}</span>
          </div>
          <div class="meta-row">
            <span class="meta-title">Model:</span>
            <span class="meta-value">{recipe.image_model || 'FLUX.1 Schnell'}</span>
          </div>
          {recipe.image_generated_at && (
            <div class="meta-row">
              <span class="meta-title">Generated:</span>
              <span class="meta-value">{new Date(recipe.image_generated_at).toLocaleDateString()}</span>
            </div>
          )}
        </div>

        {recipe.image_prompt && (
          <details class="prompt-details">
            <summary class="prompt-summary">Inspect FLUX.1 Prompt</summary>
            <p class="prompt-text">{recipe.image_prompt}</p>
          </details>
        )}

        <div class="image-actions">
          <button 
            type="button" 
            id="btn-generate-image" 
            class="btn-image-action"
          >
            {recipe.hero_image_key ? '↺ Regenerate Image' : '⚡ Generate Hero Image'}
          </button>
        </div>
      </div>

      <!-- Generation History -->
      {recipe.jobHistory && recipe.jobHistory.length > 0 && (
        <div class="card">
          <h3>Generation History</h3>
          <ul class="history-list">
            {recipe.jobHistory.map((j: any) => (
              <li class="history-item">
                <div class="history-main">
                  <span class={`status-badge-mini status-${(j.status || 'pending').toLowerCase()}`}>{j.status}</span>
                  <span class="history-stage">{j.current_stage || 'INIT'}</span>
                </div>
                <span class="history-date">{new Date(j.created_at).toLocaleTimeString()}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </form>
</AdminLayout>

<style>
