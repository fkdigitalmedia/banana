  .hidden { display: none !important; }
</style>

<script>
  const recipeId = parseInt(window.location.pathname.split('/').filter(Boolean).pop() || '0', 10);
  const toast = document.getElementById('toast');
  const factWarning = document.getElementById('fact-warning-banner');

  function showToast(msg: string, isError = false) {
    if (!toast) return;
    toast.textContent = msg;
    toast.style.background = isError ? '#dc2626' : '#16a34a';
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 4000);
  }

  // Toggle Fact Editing
  const btnToggleFact = document.getElementById('btn-toggle-fact-edit');
  const factTextareas = document.querySelectorAll('.facts-textarea') as NodeListOf<HTMLTextAreaElement>;
  const factInputs = document.querySelectorAll('.fact-input') as NodeListOf<HTMLInputElement>;
  let isEditingFacts = false;

  btnToggleFact?.addEventListener('click', () => {
    if (!isEditingFacts) {
      if (!confirm('Warning:\n\nChanging locked recipe facts may require regenerating dependent editorial content.\n\nDo you wish to continue?')) {
        return;
      }
    }
    isEditingFacts = !isEditingFacts;
    factTextareas.forEach(t => {
      t.readOnly = !isEditingFacts;
      t.classList.toggle('editing', isEditingFacts);
    });
    if (isEditingFacts) {
      btnToggleFact.textContent = '🔒 Lock Facts';
      factWarning?.classList.remove('hidden');
    } else {
      btnToggleFact.textContent = '✏️ Edit Facts';
    }
  });

  // Track Fact Inputs modification
  factInputs.forEach(input => {
    input.addEventListener('input', () => {
      factWarning?.classList.remove('hidden');
    });
  });
  factTextareas.forEach(t => {
    t.addEventListener('input', () => {
      factWarning?.classList.remove('hidden');
    });
  });

  // SERP Live Preview Updates
  const seoTitleInput = document.getElementById('seo_title') as HTMLInputElement;
  const metaDescInput = document.getElementById('meta_description') as HTMLTextAreaElement;
  const serpTitle = document.getElementById('serp-title-preview');
  const serpDesc = document.getElementById('serp-desc-preview');
  const titleCount = document.getElementById('title-char-count');
  const descCount = document.getElementById('desc-char-count');

  function updateSerp() {
    if (seoTitleInput && serpTitle && titleCount) {
      serpTitle.textContent = seoTitleInput.value || 'Recipe Title';
      titleCount.textContent = `${seoTitleInput.value.length}/60 chars`;
      titleCount.style.color = seoTitleInput.value.length > 60 ? '#dc2626' : '#71717a';
    }
    if (metaDescInput && serpDesc && descCount) {
      serpDesc.textContent = metaDescInput.value || 'Description...';
      descCount.textContent = `${metaDescInput.value.length}/155 chars`;
      descCount.style.color = metaDescInput.value.length > 155 ? '#dc2626' : '#71717a';
    }
  }

  seoTitleInput?.addEventListener('input', updateSerp);
  metaDescInput?.addEventListener('input', updateSerp);
  updateSerp();

  // Save Draft / Changes
  const btnSave = document.getElementById('btn-save-draft') as HTMLButtonElement;
  btnSave?.addEventListener('click', async () => {
    btnSave.disabled = true;
    btnSave.textContent = 'Saving...';

    const form = document.getElementById('recipe-editor-form') as HTMLFormElement;
    const formData = new FormData(form);
    const payload: Record<string, any> = { recipeId };
    formData.forEach((value, key) => { payload[key] = value; });

    try {
      const res = await fetch('/api/recipes/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Changes saved successfully! 💾');
      } else {
        showToast(data.error || 'Failed to save changes.', true);
      }
    } catch (e: any) {
      showToast(e.message, true);
    } finally {
      btnSave.disabled = false;
      btnSave.textContent = '💾 Save Changes';
    }
  });

  // Validate Facts
  const btnVal = document.getElementById('btn-validate') as HTMLButtonElement;
  const valPanel = document.getElementById('validation-panel');
  const valList = document.getElementById('validation-list');
  const btnCloseVal = document.getElementById('btn-close-val');

  btnVal?.addEventListener('click', async () => {
    btnVal.disabled = true;
    btnVal.textContent = 'Validating...';
    try {
      const res = await fetch('/api/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        if (data.result.passed) {
          showToast('✅ All fact and content quality checks passed!');
          valPanel?.classList.add('hidden');
        } else {
          valList!.innerHTML = '';
          data.result.issues.forEach((issue: any) => {
            const li = document.createElement('li');
            li.textContent = `[${issue.level.toUpperCase()}] ${issue.message}`;
            valList!.appendChild(li);
          });
          valPanel?.classList.remove('hidden');
          showToast('Validation found issues needing attention.', true);
        }
      } else {
        showToast(data.error || 'Validation failed.', true);
      }
    } catch (e: any) {
      showToast(e.message, true);
    } finally {
      btnVal.disabled = false;
      btnVal.textContent = '🔍 Validate Facts';
    }
  });

  btnCloseVal?.addEventListener('click', () => valPanel?.classList.add('hidden'));

  // Section Regenerate Buttons
  document.querySelectorAll('.btn-regenerate').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const section = target.dataset.section;
      if (!section) return;

      if (!confirm(`Regenerate this section?\n\nThe section will be regenerated using the locked recipe facts.`)) {
        return;
      }

      const originalText = target.textContent;
      target.disabled = true;
      target.textContent = '↻ Regenerating...';

      try {
        const res = await fetch('/api/generate/section', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId, section })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast(`Section "${section}" regenerated! Updating view...`);
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Regeneration failed.', true);
          target.disabled = false;
          target.textContent = originalText;
        }
      } catch (e: any) {
        showToast(e.message, true);
        target.disabled = false;
        target.textContent = originalText;
      }
    });
  });

  // Approve
  const btnApprove = document.getElementById('btn-approve') as HTMLButtonElement | null;
  btnApprove?.addEventListener('click', async () => {
    btnApprove.disabled = true;
    btnApprove.textContent = 'Approving...';
    try {
      const res = await fetch('/api/editorial/approve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('✓ Recipe APPROVED for publication!');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(data.error || 'Approval failed.', true);
        btnApprove.disabled = false;
        btnApprove.textContent = '✓ Approve';
      }
    } catch (e: any) {
      showToast(e.message || 'Network error.', true);
      btnApprove.disabled = false;
      btnApprove.textContent = '✓ Approve';
    }
  });

  // Publish
  const btnPublish = document.getElementById('btn-publish') as HTMLButtonElement;
  btnPublish?.addEventListener('click', async () => {
    if (!confirm('Publish this recipe? It will become live and publicly indexable on the website.')) return;
    btnPublish.disabled = true;
    btnPublish.textContent = 'Publishing...';
    try {
      const res = await fetch('/api/publish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Recipe published successfully! 🚀');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast(data.error || 'Publishing failed.', true);
      }
    } catch (e: any) {
      showToast(e.message, true);
    } finally {
      btnPublish.disabled = false;
      btnPublish.textContent = '🚀 Publish Recipe';
    }
  });

  // Unpublish
  const btnUnpublish = document.getElementById('btn-unpublish');
  btnUnpublish?.addEventListener('click', async () => {
    if (!confirm('Unpublish this recipe? The public page will no longer be accessible.')) return;
    btnUnpublish.textContent = 'Unpublishing...';
    try {
      const res = await fetch('/api/unpublish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Recipe unpublished and returned to Draft! ✅');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast(data.error || 'Failed to unpublish.', true);
      }
    } catch (e: any) {
      showToast(e.message, true);
    }
  });

  // Delete Recipe
  const btnDelete = document.getElementById('btn-delete-recipe');
  btnDelete?.addEventListener('click', async () => {
    if (!confirm('Delete this recipe permanently? This will remove all ingredients, instructions, and generated editorial content.')) {
      return;
    }
    try {
      const res = await fetch('/api/recipes/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Recipe deleted. Redirecting...');
        setTimeout(() => window.location.href = '/admin/recipes/', 1000);
      } else {
        showToast(data.error || 'Failed to delete recipe.', true);
      }
    } catch (e: any) {
      showToast(e.message, true);
    }
  });

  // Full DeepSeek Generation Flow
  const btnStartGen = document.getElementById('btn-start-generation') as HTMLButtonElement;
  const genModal = document.getElementById('generation-modal');
  const genStatusText = document.getElementById('generation-status-text');
  const modalErrorMsg = document.getElementById('modal-error-msg');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnReloadPage = document.getElementById('btn-reload-page');

  btnStartGen?.addEventListener('click', async () => {
    genModal?.classList.remove('hidden');
    modalErrorMsg?.classList.add('hidden');
    btnCloseModal?.classList.add('hidden');
    btnReloadPage?.classList.add('hidden');

    const stageItems = document.querySelectorAll('.stage-item');
    stageItems.forEach(el => {
      el.className = 'stage-item';
      const icon = el.querySelector('.stage-icon');
      if (icon) icon.textContent = '⏳';
    });

    let currentStep = 1;
    const interval = setInterval(() => {
      if (currentStep <= 12) {
        const item = document.querySelector(`.stage-item[data-stage="${currentStep}"]`);
        if (item) {
          item.className = 'stage-item running';
          const icon = item.querySelector('.stage-icon');
          if (icon) icon.textContent = '↻';
        }
        if (currentStep > 1) {
          const prev = document.querySelector(`.stage-item[data-stage="${currentStep - 1}"]`);
          if (prev) {
            prev.className = 'stage-item completed';
            const icon = prev.querySelector('.stage-icon');
            if (icon) icon.textContent = '✓';
          }
        }
        currentStep++;
      }
    }, 1800);

    try {
      const res = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });

      clearInterval(interval);

      const data = await res.json();
      if (res.ok && data.status === 'success') {
        stageItems.forEach(el => {
          el.className = 'stage-item completed';
          const icon = el.querySelector('.stage-icon');
          if (icon) icon.textContent = '✓';
        });

        if (genStatusText) {
          genStatusText.textContent = 'Completed ✅';
          genStatusText.style.background = '#dcfce7';
          genStatusText.style.color = '#15803d';
        }

        btnReloadPage?.classList.remove('hidden');
        showToast('Editorial generation complete! Draft ready. 🎉');
      } else {
        if (genStatusText) {
          genStatusText.textContent = 'Failed ❌';
          genStatusText.style.background = '#fee2e2';
          genStatusText.style.color = '#b91c1c';
        }
        if (modalErrorMsg) {
          modalErrorMsg.textContent = data.error || 'Generation failed.';
          modalErrorMsg.classList.remove('hidden');
        }
        btnCloseModal?.classList.remove('hidden');
      }
    } catch (e: any) {
      clearInterval(interval);
      if (modalErrorMsg) {
        modalErrorMsg.textContent = e.message || 'Network communication error.';
        modalErrorMsg.classList.remove('hidden');
      }
      btnCloseModal?.classList.remove('hidden');
    }
  });

  btnCloseModal?.addEventListener('click', () => genModal?.classList.add('hidden'));
  btnReloadPage?.addEventListener('click', () => window.location.reload());

  // Image Generation with Runware FLUX.1 Schnell
  const btnGenImg = document.getElementById('btn-generate-image') as HTMLButtonElement;
  btnGenImg?.addEventListener('click', async () => {
    const isRegen = btnGenImg.textContent?.includes('Regenerate');
    const confirmMsg = isRegen 
      ? 'Regenerate a new recipe hero image with Runware FLUX.1 Schnell? This will replace the current hero image.'
      : 'Generate a new recipe hero image with Runware FLUX.1 Schnell?';
    
    if (!confirm(confirmMsg)) return;

    btnGenImg.disabled = true;
    btnGenImg.textContent = '↻ Generating with FLUX.1 Schnell...';

    try {
      const res = await fetch('/api/recipes/generate-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast('Hero image generated and saved to R2! 🎨');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast(data.error || 'Image generation failed.', true);
        btnGenImg.disabled = false;
        btnGenImg.textContent = isRegen ? '↺ Regenerate Image' : '⚡ Generate Hero Image';
      }
    } catch (e: any) {
      showToast(e.message || 'Network error.', true);
      btnGenImg.disabled = false;
      btnGenImg.textContent = isRegen ? '↺ Regenerate Image' : '⚡ Generate Hero Image';
    }
  });

  // Re-run Quality Assessment
  const btnQuality = document.getElementById('btn-run-quality-check') as HTMLButtonElement;
  btnQuality?.addEventListener('click', async () => {
    btnQuality.disabled = true;
    btnQuality.textContent = '🔍 Evaluating Quality...';
    try {
      const res = await fetch('/api/quality/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast(`Quality Score: ${data.report.score}/100 (${data.report.status})! Updating view...`);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(data.error || 'Quality evaluation failed.', true);
        btnQuality.disabled = false;
        btnQuality.textContent = '🔍 Re-run Quality Assessment';
      }
    } catch (e: any) {
      showToast(e.message, true);
      btnQuality.disabled = false;
      btnQuality.textContent = '🔍 Re-run Quality Assessment';
    }
  });

  // Auto-Fix & Solve Quality Issues Handler
  async function handleSolveQualityIssues(issueIndex?: number, issueType?: string) {
    const btnAutoFix = document.getElementById('btn-auto-fix-issues') as HTMLButtonElement | null;
    const btnHeader = document.getElementById('btn-solve-issues-header') as HTMLButtonElement | null;
    const allActionBtns = document.querySelectorAll('.btn-solve-single-issue, #btn-auto-fix-issues, #btn-solve-issues-header') as NodeListOf<HTMLButtonElement>;

    allActionBtns.forEach(b => { b.disabled = true; });
    if (btnAutoFix) btnAutoFix.textContent = '🛠️ Solving Issues...';
    if (btnHeader) btnHeader.textContent = '⏳ Solving...';

    try {
      showToast('Repairing detected issues and verifying facts... 🛠️');
      const res = await fetch('/api/quality/repair', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipeId, issueIndex, issueType })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        showToast(`✨ Issues solved! New Quality Score: ${data.report.score}/100 (${data.report.status}) 🎉`);

        // Live-update form textareas if present
        if (data.content) {
          const c = data.content;
          const setVal = (id: string, val: any) => {
            const el = document.getElementById(id) as HTMLTextAreaElement | HTMLInputElement | null;
            if (el && val !== undefined) {
              if (Array.isArray(val)) {
                el.value = val.join('\n');
              } else {
                el.value = String(val);
              }
            }
          };
          if (c.introduction) setVal('introduction', c.introduction);
          if (c.why_this_recipe) setVal('why_this_recipe', c.why_this_recipe);
          if (c.cooking_guidance) setVal('cooking_guidance', c.cooking_guidance);
          if (c.tips) setVal('tips', c.tips);
          if (c.serving_suggestions) setVal('serving_suggestions', c.serving_suggestions);
          if (c.storage) setVal('storage', c.storage);
        }

        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast(data.error || 'Failed to auto-repair quality issues.', true);
        allActionBtns.forEach(b => { b.disabled = false; });
        if (btnAutoFix) btnAutoFix.textContent = '✨ Auto-Fix & Solve Issues';
        if (btnHeader) btnHeader.textContent = '✨ Solve Issues';
      }
    } catch (e: any) {
      showToast(e.message || 'Network error.', true);
      allActionBtns.forEach(b => { b.disabled = false; });
      if (btnAutoFix) btnAutoFix.textContent = '✨ Auto-Fix & Solve Issues';
      if (btnHeader) btnHeader.textContent = '✨ Solve Issues';
    }
  }

  document.getElementById('btn-auto-fix-issues')?.addEventListener('click', () => handleSolveQualityIssues());
  document.getElementById('btn-solve-issues-header')?.addEventListener('click', () => handleSolveQualityIssues());
  document.querySelectorAll('.btn-solve-single-issue').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const idx = target.dataset.issueIndex ? parseInt(target.dataset.issueIndex, 10) : undefined;
      const type = target.dataset.issueType;
      handleSolveQualityIssues(idx, type);
    });
  });

  // Image Management Actions
  document.querySelectorAll('.btn-use-image').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const heroType = target.dataset.type;
      const heroKey = target.dataset.key;
      target.disabled = true;
      target.textContent = 'Updating...';

      try {
        const res = await fetch('/api/recipes/image-actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'SET_ACTIVE_HERO', recipeId, heroType, heroKey })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast(`✓ Active hero set to ${heroType}!`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(data.error || 'Failed to update hero image', true);
          target.disabled = false;
          target.textContent = '✓ Use as Hero';
        }
      } catch (err: any) {
        showToast(err.message || 'Network error', true);
        target.disabled = false;
        target.textContent = '✓ Use as Hero';
      }
    });
  });

  document.querySelectorAll('.select-rights-status').forEach(select => {
    select.addEventListener('change', async (e) => {
      const target = e.currentTarget as HTMLSelectElement;
      const rightsStatus = target.value;

      try {
        const res = await fetch('/api/recipes/image-actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'UPDATE_RIGHTS_STATUS', recipeId, rightsStatus })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast(`Rights status updated to ${rightsStatus}`);
          setTimeout(() => window.location.reload(), 600);
        } else {
          showToast(data.error || 'Failed to update rights', true);
        }
      } catch (err: any) {
        showToast(err.message || 'Network error', true);
      }
    });
  });

  document.querySelectorAll('.btn-reimport-source').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      target.disabled = true;
      target.textContent = '📥 Importing...';

      try {
        showToast('Downloading source recipe image to Cloudflare R2... ⏳');
        const res = await fetch('/api/recipes/image-actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'RETRY_SOURCE_IMPORT', recipeId, force: true })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast('Source image imported and saved to R2! 📸');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to import source image.', true);
          target.disabled = false;
          target.textContent = '↻ Re-import';
        }
      } catch (err: any) {
        showToast(err.message || 'Network error.', true);
        target.disabled = false;
        target.textContent = '↻ Re-import';
      }
    });
  });

  document.querySelectorAll('.btn-generate-ai-img').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      target.disabled = true;
      target.textContent = '↻ Generating FLUX.1...';

      try {
        showToast('Generating hero image with Runware FLUX.1 Schnell... 🎨');
        const res = await fetch('/api/recipes/image-actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'GENERATE_AI_IMAGE', recipeId })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast('AI image generated and stored in R2! 🚀');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'AI image generation failed.', true);
          target.disabled = false;
          target.textContent = '✨ Generate AI Image';
        }
      } catch (err: any) {
        showToast(err.message || 'Network error.', true);
        target.disabled = false;
        target.textContent = '✨ Generate AI Image';
      }
    });
  });
</script>
