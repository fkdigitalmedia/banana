---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RecipeHero from '../components/RecipeHero.astro';
import RecipeMeta from '../components/RecipeMeta.astro';
import RecipeIngredients from '../components/RecipeIngredients.astro';
import RecipeInstructions from '../components/RecipeInstructions.astro';
import RecipeFAQ from '../components/RecipeFAQ.astro';
import RelatedRecipes from '../components/RelatedRecipes.astro';
import AuthorBox from '../components/AuthorBox.astro';

export const prerender = true;

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const SITE_URL = 'https://bananabreadrecipe.xyz';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { Content } = await recipe.render();
const data = recipe.data;
const slug = recipe.slug;
const canonical = `${SITE_URL}/${slug}/`;

const categoryNames: Record<string, string> = {
  bread: 'Bread',
  baking: 'Baking',
  cakes: 'Cakes',
  desserts: 'Desserts',
  breakfast: 'Breakfast',
  cookies: 'Cookies',
  muffins: 'Muffins',
};
const categoryName = categoryNames[data.category] || data.category;

const ingredients = data.ingredients.map((name) => ({ name }));
const instructions = data.instructions.map((text, i) => ({ step_number: i + 1, text }));

// Related: same category first, then newest others
const allRecipes = await getCollection('recipes');
const related = [
  ...allRecipes.filter((r) => r.slug !== slug && r.data.category === data.category),
  ...allRecipes.filter((r) => r.slug !== slug && r.data.category !== data.category),
]
  .slice(0, 6)
  .map((r) => ({
    title: r.data.title,
    slug: r.slug,
    description: r.data.description,
    heroImage: r.data.heroImage,
    prepTime: r.data.prepTime,
    cookTime: r.data.cookTime,
    totalTime: r.data.totalTime,
    servings: r.data.servings,
    category: categoryNames[r.data.category] || r.data.category,
  }));

function isoDuration(min?: number) {
  if (!min) return undefined;
  const h = Math.floor(min / 60);
  const m = min % 60;
  return `PT${h > 0 ? h + 'H' : ''}${m > 0 ? m + 'M' : ''}` || undefined;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: data.title,
  description: data.description,
  image: data.heroImage ? [`${SITE_URL}${data.heroImage}`] : [],
  author: { '@type': 'Organization', name: 'BananaBread', url: SITE_URL },
  datePublished: data.pubDate.toISOString().split('T')[0],
  prepTime: isoDuration(data.prepTime),
  cookTime: isoDuration(data.cookTime),
  totalTime: isoDuration(data.totalTime),
  recipeYield: data.servings,
  recipeCategory: categoryName,
  recipeCuisine: data.cuisine,
  recipeIngredient: data.ingredients,
  recipeInstructions: data.instructions.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Recipes', item: `${SITE_URL}/recipes/` },
    { '@type': 'ListItem', position: 3, name: categoryName, item: `${SITE_URL}/recipes/${data.category}/` },
    { '@type': 'ListItem', position: 4, name: data.title, item: canonical },
  ],
};
---

<BaseLayout
  title={`${data.title} - BananaBread`}
  description={data.description}
  canonical={canonical}
  og={{
    title: data.title,
    description: data.description,
    image: data.heroImage ? `${SITE_URL}${data.heroImage}` : `${SITE_URL}/favicon.svg`,
    type: 'article',
  }}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <div class="container recipe-container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Recipes', href: '/recipes/' },
        { label: categoryName, href: `/recipes/${data.category}/` },
        { label: data.title },
      ]}
    />

    <RecipeHero
      title={data.title}
      description={data.description}
      image={data.heroImage}
      imageAlt={data.heroImageAlt}
    />

    <RecipeMeta
      prepTime={data.prepTime}
      cookTime={data.cookTime}
      totalTime={data.totalTime}
      servings={data.servings}
      cuisine={data.cuisine}
      category={categoryName}
    />

    <div class="jump-bar">
      <a href="#recipe-card" class="btn-jump">⬇ Jump to Recipe Card</a>
      <button type="button" onclick="window.print()" class="btn-print">🖨️ Print Recipe</button>
    </div>

    <div class="article-body">
      <Content />
    </div>

    {data.faq && data.faq.length > 0 && <RecipeFAQ faq={data.faq} />}

    <div id="recipe-card" class="printable-recipe-card">
      <div class="card-top">
        <h2>{data.title}</h2>
        <p class="recipe-summary">{data.description}</p>
        <div class="recipe-facts-bar">
          <div class="fact"><span>Prep Time:</span> {data.prepTime ? `${data.prepTime} mins` : '—'}</div>
          <div class="fact"><span>Cook Time:</span> {data.cookTime ? `${data.cookTime} mins` : '—'}</div>
          <div class="fact"><span>Total Time:</span> {data.totalTime ? `${data.totalTime} mins` : '—'}</div>
          <div class="fact"><span>Servings:</span> {data.servings || '—'}</div>
        </div>
      </div>
      <div class="recipe-main-grid">
        <div class="ingredients-column">
          <RecipeIngredients ingredients={ingredients} />
        </div>
        <div class="instructions-column">
          <RecipeInstructions instructions={instructions} />
        </div>
      </div>
    </div>

    <AuthorBox />
    <RelatedRecipes recipes={related} />
  </div>
</BaseLayout>

<style>
  .recipe-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem 1rem;
  }
  .jump-bar {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 2.5rem 0;
  }
  .btn-jump {
    background: #8B4513;
    color: white;
    padding: 0.7rem 1.35rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-jump:hover { background: #6F370F; }
  .btn-print {
    background: #FFF8F0;
    color: #8B4513;
    border: 1px solid #E8D5C4;
    padding: 0.7rem 1.35rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-print:hover { background: #FDE8D3; }

  .article-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #2C1810;
    margin-bottom: 3.5rem;
  }
  .article-body h2 {
    font-family: 'Georgia', 'Palatino', serif;
    color: #2C1810;
    font-size: 1.65rem;
    margin: 2.5rem 0 1.15rem 0;
    border-bottom: 2px solid #E8D5C4;
    padding-bottom: 0.45rem;
  }
  .article-body h3 {
    font-family: 'Georgia', serif;
    color: #8B4513;
    font-size: 1.3rem;
    margin: 2rem 0 0.9rem 0;
  }
  .article-body h4 {
    color: #8B4513;
    font-size: 1.1rem;
    margin: 1.5rem 0 0.6rem 0;
  }
  .article-body p { margin-bottom: 1.25rem; }
  .article-body ul, .article-body ol { margin-bottom: 1.25rem; padding-left: 1.5rem; }
  .article-body li { margin-bottom: 0.5rem; }
  .article-body img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1.5rem auto;
    display: block;
    box-shadow: 0 4px 18px rgba(0,0,0,0.08);
  }
  .article-body blockquote {
    background: #FFF8F0;
    border-left: 4px solid #D2691E;
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem;
    margin: 1.75rem 0;
    font-style: italic;
  }

  .printable-recipe-card {
    background: #FFFDF8;
    border: 2px solid #E8D5C4;
    border-radius: 12px;
    padding: 2rem;
    margin: 3rem 0;
  }
  .printable-recipe-card h2 {
    font-family: 'Georgia', serif;
    color: #2C1810;
    margin-top: 0;
  }
  .recipe-summary { color: #5c4a3a; margin-bottom: 1.5rem; }
  .recipe-facts-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    background: #FFF8F0;
    border: 1px solid #E8D5C4;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
  }
  .recipe-facts-bar .fact { font-size: 0.95rem; }
  .recipe-facts-bar .fact span { font-weight: 700; color: #8B4513; }
  .recipe-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
  }
  @media (max-width: 700px) {
    .recipe-main-grid { grid-template-columns: 1fr; }
  }
</style>
