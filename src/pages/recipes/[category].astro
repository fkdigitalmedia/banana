---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export const prerender = true;

const SITE_URL = 'https://bananabreadrecipe.xyz';

const categoryNames: Record<string, string> = {
  bread: 'Bread', baking: 'Baking', cakes: 'Cakes', desserts: 'Desserts',
  breakfast: 'Breakfast', cookies: 'Cookies', muffins: 'Muffins',
};

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const slugs = [...new Set(recipes.map((r) => r.data.category))];
  return slugs.map((slug) => ({ params: { category: slug } }));
}

const { category: categorySlug } = Astro.params;
const cleanSlug = (categorySlug || '').replace(/^\/+|\/+$/g, '');
const categoryName = categoryNames[cleanSlug] || cleanSlug;

const allRecipes = (await getCollection('recipes'))
  .filter((r) => r.data.category === cleanSlug)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recipes = allRecipes.map((r: any) => ({
  title: r.data.title,
  slug: r.slug,
  description: r.data.description,
  heroImage: r.data.heroImage,
  prepTime: r.data.prepTime,
  cookTime: r.data.cookTime,
  totalTime: r.data.totalTime,
  servings: r.data.servings,
  category: categoryName,
}));

const title = `${categoryName} Recipes — Tested Homemade ${categoryName}`;
const description = `Explore our tested collection of delicious homemade ${categoryName.toLowerCase()} recipes.`;
const canonical = `${SITE_URL}/recipes/${cleanSlug}/`;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container page-container">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'All Recipes', href: '/recipes/' },
      { label: categoryName }
    ]} />

    <header class="category-header">
      <span class="catalog-badge">📂 Category</span>
      <h1 class="catalog-title">{categoryName} Recipes</h1>
      <p class="catalog-subtitle">{description}</p>
    </header>

    {recipes.length === 0 ? (
      <div class="empty-catalog">
        <span class="empty-icon">🍞</span>
        <h2>No recipes in this category yet</h2>
        <p>We are actively testing new recipes. Check back soon!</p>
        <a href="/recipes/" class="btn-home">← All Recipes</a>
      </div>
    ) : (
      <div class="recipe-grid">
        {recipes.map((recipe) => (
          <RecipeCard recipe={recipe} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container { padding: 1.5rem 1rem 4rem 1rem; }
  .category-header { text-align: center; margin: 1rem 0 2.5rem 0; }
  .catalog-badge {
    display: inline-block;
    background: #FFF8F0;
    border: 1px solid #E8D5C4;
    color: #8B4513;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .catalog-title {
    font-family: 'Georgia', serif;
    font-size: 2.25rem;
    color: #2C1810;
    margin: 0 0 0.75rem 0;
  }
  .catalog-subtitle { color: #5c4a3a; max-width: 640px; margin: 0 auto; }
  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }
  .empty-catalog { text-align: center; padding: 4rem 1rem; }
  .empty-catalog .empty-icon { font-size: 3rem; }
  .btn-home {
    display: inline-block;
    margin-top: 1rem;
    background: #8B4513;
    color: #fff;
    padding: 0.7rem 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
</style>
