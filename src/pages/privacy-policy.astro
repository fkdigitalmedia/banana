---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const env = (Astro.locals as any).runtime?.env || {};
const configuredEmail = env.CONTACT_EMAIL || 'privacy@bananabread.org';

const title = "Privacy Policy — BananaBread";
const description = "Privacy Policy for BananaBread, detailing cookies, Google advertising disclosures, analytics, and your privacy choices.";
---

<BaseLayout title={title} description={description}>
  <div class="container page-container">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Privacy Policy' }
    ]} />

    <article class="legal-content prose">
      <h1>Privacy Policy</h1>
      <p class="updated-date">Effective Date: January 1, 2026 | Last Updated: March 2026</p>
      
      <p class="lead">At BananaBread, we respect your privacy and are committed to transparency about the data we collect, how it is used, and your choices regarding that data.</p>

      <h2>1. Information We Collect</h2>
      <p>When you visit BananaBread, we may collect information in the following ways:</p>
      <ul>
        <li><strong>Log & Technical Data:</strong> When accessing our website, web servers automatically record information such as your Internet Protocol (IP) address, browser type and version, referring/exit pages, operating system, date/time stamps, and basic clickstream data. This data is used solely for technical administration, server security, and site optimization.</li>
        <li><strong>Direct Communications:</strong> If you contact our editorial team via email, we receive your email address and any information contained within your message. We use this information solely to respond to your inquiry.</li>
      </ul>

      <h2>2. Cookies & Web Beacons</h2>
      <p>Like most modern websites, BananaBread uses cookies—small text files placed on your device—to ensure site functionality and enhance your reading experience:</p>
      <ul>
        <li><strong>Essential Cookies:</strong> Required for fundamental site operations (such as session security for administrative users).</li>
        <li><strong>Preference Cookies:</strong> Used to remember your recipe preferences (such as ingredient checkbox states stored locally in your browser).</li>
        <li><strong>Analytics Cookies:</strong> Aggregated, non-personally identifiable metrics on page views and popular recipes to help us improve content.</li>
      </ul>

      <h2>3. Google AdSense & Third-Party Advertising Disclosures</h2>
      <p>BananaBread may partner with third-party advertising vendors, including Google, to serve advertisements when you visit our website. Please review the following disclosures regarding how advertising partners manage data:</p>
      <ul>
        <li>Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites on the Internet.</li>
        <li>Google's use of advertising cookies enables it and its partners to serve ads to users based on their visits to our site and/or other sites across the Web.</li>
        <li>Users may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.</li>
        <li>Alternatively, users can opt out of third-party vendors' use of cookies for personalized advertising by visiting the <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer">Digital Advertising Alliance Consumer Choice page (www.aboutads.info)</a> or the <a href="https://www.networkadvertising.org/choices/" target="_blank" rel="noopener noreferrer">Network Advertising Initiative (NAI)</a>.</li>
      </ul>

      <h2>4. Third-Party Links & Content</h2>
      <p>Our website may contain links to external culinary resources, food science references, or source publications. We do not control and are not responsible for the privacy practices or content of third-party websites.</p>

      <h2>5. Data Retention & Security</h2>
      <p>We do not maintain marketing databases or sell personal data. Technical server logs are retained only as long as necessary for security diagnostics and traffic analysis. We implement reasonable technical and organizational security measures to protect information against unauthorized access, alteration, or disclosure.</p>

      <h2>6. Your Privacy Choices & Rights (GDPR / CCPA)</h2>
      <p>Depending on your geographic location, you may have rights under applicable privacy legislation (such as the EU General Data Protection Regulation or California Consumer Privacy Act), including:</p>
      <ul>
        <li>The right to access or receive a copy of any personal data we hold about you.</li>
        <li>The right to request deletion of direct email correspondence.</li>
        <li>The right to disable cookies through your individual browser preferences or using the opt-out links provided above.</li>
      </ul>

      <h2>7. Updates to This Policy</h2>
      <p>We may periodically update this Privacy Policy to reflect changes in our practices or legal obligations. When revised, the "Last Updated" date at the top of this page will be refreshed.</p>

      <h2>8. Contact Information</h2>
      <p>If you have any questions or privacy-related concerns regarding this policy, please reach out to our privacy administrator at: <a href={`mailto:${configuredEmail}`}>{configuredEmail}</a>.</p>
    </article>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding: 2rem 1rem;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .legal-content h1 {
    font-size: 2.5rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  
  .updated-date {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-style: italic;
    font-size: 0.95rem;
  }

  .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-primary);
    margin-bottom: 2rem;
  }
  
  .legal-content h2 {
    color: var(--primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }
  
  .legal-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .legal-content ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .legal-content li {
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .legal-content a {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 500;
  }
</style>
