---
import { getRecipeImageUrl } from '../lib/image/storage';

interface Props {
  recipe: {
    id: string | number;
    title: string;
    slug: string;
    description?: string;
    hero_image_key?: string;
    original_image_url?: string;
    prep_time?: number;
    cook_time?: number;
    total_time?: number;
    servings?: string | number;
    category_name?: string;
  };
  r2BaseUrl?: string;
}

const { recipe, r2BaseUrl } = Astro.props;
const imageUrl = getRecipeImageUrl({ hero_image_key: recipe.hero_image_key, original_image_url: recipe.original_image_url }, r2BaseUrl);

const totalTime = recipe.total_time || ((recipe.prep_time || 0) + (recipe.cook_time || 0));

function formatTime(minutes: number) {
  if (!minutes || minutes <= 0) return '';
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  if (h > 0 && m > 0) return `${h} hr ${m} min`;
  if (h > 0) return `${h} hr`;
  return `${m} min`;
}
---

<a href={`/${recipe.slug}/`} class="recipe-card">
  <div class="recipe-card-img-wrapper">
    <img 
      src={imageUrl} 
      alt={`Freshly baked ${recipe.title}`} 
      loading="lazy" 
      width="400"
      height="267"
      class="recipe-card-img" 
    />
    {recipe.category_name && (
      <span class="recipe-card-badge">{recipe.category_name}</span>
    )}
  </div>
  <div class="recipe-card-content">
    <h3 class="recipe-card-title">{recipe.title}</h3>
    <p class="recipe-card-desc">
      {recipe.description && recipe.description.length > 110 
        ? recipe.description.substring(0, 110) + '...' 
        : (recipe.description || 'A delicious, foolproof homemade recipe tested in our kitchen.')}
    </p>
    <div class="recipe-card-meta">
      {totalTime > 0 && <span>⏱️ {formatTime(totalTime)}</span>}
      {recipe.servings && <span>🍽️ {recipe.servings}</span>}
    </div>
  </div>
</a>

<style>
  .recipe-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFDF7;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .recipe-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(139, 69, 19, 0.08);
  }
  .recipe-card-img-wrapper {
    position: relative;
    padding-top: 66.66%; /* 3:2 aspect ratio */
    overflow: hidden;
    background: #FFF8F0;
  }
  .recipe-card-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .recipe-card:hover .recipe-card-img {
    transform: scale(1.04);
  }
  .recipe-card-badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    background: var(--primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 1;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .recipe-card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .recipe-card-title {
    font-family: 'Georgia', serif;
    font-size: 1.3rem;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .recipe-card-desc {
    color: var(--text-secondary);
    font-size: 0.925rem;
    margin: 0 0 1.25rem 0;
    flex: 1;
    line-height: 1.5;
  }
  .recipe-card-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
    margin-top: auto;
  }
</style>
