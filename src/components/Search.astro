---
---
<form class="search-form" method="GET" action="/search/">
  <input type="search" name="q" placeholder="Search recipes..." required class="search-input" />
  <button type="submit" class="search-button" aria-label="Search">🔍</button>
</form>

<style>
  .search-form {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    max-width: 300px;
  }
  .search-input {
    width: 100%;
    padding: 0.5rem 2.5rem 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 20px;
    background-color: var(--surface);
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(139, 69, 19, 0.1);
    background-color: #fff;
  }
  .search-button {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    font-size: 1rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .search-button:hover {
    opacity: 1;
  }
</style>
