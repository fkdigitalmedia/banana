---
interface Props {
  tips: string[];
}

const { tips } = Astro.props;

if (!tips || tips.length === 0) {
  return null;
}
---

<div class="recipe-tips">
  <h3>💡 Expert Tips</h3>
  <ul>
    {tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>
</div>

<style>
  .recipe-tips {
    background-color: #fff9e6;
    border: 1px solid #ffeeba;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }
  
  .recipe-tips h3 {
    color: #856404;
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  
  .recipe-tips ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .recipe-tips li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .recipe-tips li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #856404;
    font-weight: bold;
  }
  
  .recipe-tips li:last-child {
    margin-bottom: 0;
  }
</style>
