---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li aria-current={isLast ? "page" : undefined}>
          {!isLast && item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span>{item.label}</span>
          )}
          {!isLast && <span class="separator">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 1rem 0;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
  }
  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .breadcrumbs span {
    color: var(--text-primary);
  }
  .separator {
    margin: 0 0.5rem;
    color: var(--border) !important;
  }
</style>
